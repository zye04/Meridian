#version 460

// Bakes the colour grade and the AgX display transform into one 3D LUT,
// indexed by grade.glsl's log2 shaper of the AgX-inset colour. Mirrors
// grade.cpp (gradeColor, agxDisplay, bakeGradeLut) operation for operation;
// Debug builds compare the result with it. AgX (Troy Sobotka) follows
// Filament's implementation (google/filament, src/ToneMapper.cpp,
// Apache-2.0).

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#include "grade.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

// Post set binding 6: the LUT the tonemap samples at binding 5.
layout(set = 0, binding = 6, rgba16f) uniform writeonly image3D gradeLutOut;

// Must match GpuGrade in C++.
layout(buffer_reference, std430) readonly buffer GradeBuffer {
    vec4 whiteBalance[3]; // rows of the Rec.2020 white-balance matrix
    vec4 slope;
    vec4 offset;
    vec4 power;
    float exposureScale;
    float contrast;
    float saturation;
    float pad;
    // Per OKLCh band (greens, blues, browns): centre and half-width in
    // degrees, hue shift in degrees, saturation.
    vec4 bands[3];
};

layout(push_constant) uniform GradeConstants {
    GradeBuffer grade;
};

const mat3 kAgxInsetToRec709 = mat3(
    2.1144724, -0.370503884, -0.16593189,
    -1.02737543, 1.55292599, -0.254715263,
    -0.0870973866, -0.182420115, 1.42064719);
const mat3 kAgxOutset = mat3(
    1.127100582, -0.141329763, -0.141329763,
    -0.110606643, 1.157823702, -0.110606643,
    -0.016493939, -0.016493939, 1.251936407);
const mat3 kRec2020ToRec709 = mat3(
    1.660490296, -0.124549970, -0.018151119,
    -0.587639106, 1.132899922, -0.100578724,
    -0.072851598, -0.008347964, 1.118729878);
const mat3 kRec709ToRec2020 = mat3(
    0.627404, 0.069097, 0.0163916001,
    0.329282, 0.91954, 0.0880132001,
    0.0433135998, 0.0113611998, 0.895595);
// OKLab (Ottosson 2020) from Rec.2020 through XYZ.
const mat3 kRec2020ToOklabLms = mat3(
    0.616688442, 0.265140196, 0.100150645,
    0.360159071, 0.635856485, 0.204004324,
    0.0230432932, 0.0990302331, 0.696324677);
const mat3 kOklabLmsToRec2020 = mat3(
    2.14014041, -0.884832453, -0.048579058,
    -1.24635595, 2.16317272, -0.454490908,
    0.106431726, -0.278361591, 1.50235629);
const mat3 kOklabLmsToLab = mat3(
    0.210454255, 1.9779985, 0.0259040371,
    0.793617785, -2.42859221, 0.782771766,
    -0.0040720468, 0.45059371, -0.808675766);
const mat3 kOklabLabToLms = mat3(
    0.999999998, 1.00000001, 1.00000005,
    0.396337792, -0.105561342, -0.0894841821,
    0.215803758, -0.0638541748, -1.29148554);

const float kAgxMinEv = -12.47393;
const float kAgxMaxEv = 4.026069;
const float kPi = 3.14159265358979;
const float kDegrees = 180.0 / kPi;

vec3 agxContrast(vec3 x) {
    vec3 x2 = x * x;
    vec3 x4 = x2 * x2;
    vec3 x6 = x4 * x2;
    return -17.86 * x6 * x + 78.01 * x6 - 126.7 * x4 * x + 92.06 * x4 -
           28.72 * x2 * x + 4.361 * x2 - 0.1718 * x + 0.002857;
}

vec3 agxDisplay(vec3 rec709) {
    vec3 v = kRec709ToAgxInset * max(rec709, 0.0);
    v = clamp((log2(max(v, 1e-10)) - kAgxMinEv) / (kAgxMaxEv - kAgxMinEv),
              0.0, 1.0);
    v = agxContrast(v);
    v = kAgxOutset * v;
    v = pow(max(v, 0.0), vec3(2.2));
    return kRec2020ToRec709 * v;
}

// Signed, like std::cbrt: saturation above 1 can push LMS below zero.
vec3 cbrt(vec3 x) { return sign(x) * pow(abs(x), vec3(1.0 / 3.0)); }

vec3 applyBands(vec3 lab) {
    float hue = atan(lab.z, lab.y) * kDegrees;
    float rotation = 0.0;
    float chromaScale = 1.0;
    for (int i = 0; i < 3; ++i) {
        vec4 band = grade.bands[i];
        float d = hue - band.x;
        float distance = abs(d - 360.0 * round(d / 360.0));
        if (distance >= band.y) {
            continue;
        }
        float weight = 0.5 + 0.5 * cos(kPi * distance / band.y);
        rotation += weight * band.z;
        chromaScale *= 1.0 + weight * (band.w - 1.0);
    }
    // Scaling and rotating (a, b) moves a colour by an amount proportional
    // to its chroma, so greys stay grey.
    float c = cos(rotation / kDegrees) * chromaScale;
    float s = sin(rotation / kDegrees) * chromaScale;
    return vec3(lab.x, c * lab.y - s * lab.z, s * lab.y + c * lab.z);
}

vec3 gradeColor(vec3 rec2020) {
    vec3 c = vec3(dot(grade.whiteBalance[0].xyz, rec2020),
                  dot(grade.whiteBalance[1].xyz, rec2020),
                  dot(grade.whiteBalance[2].xyz, rec2020));
    c *= grade.exposureScale;
    c = c * grade.slope.xyz + grade.offset.xyz;
    c = pow(max(c, 0.0), grade.power.xyz);
    c = 0.18 * pow(c / 0.18, vec3(grade.contrast));
    float luminance = dot(c, vec3(0.2627, 0.6780, 0.0593));
    c = luminance + (c - luminance) * grade.saturation;

    vec3 lab = kOklabLmsToLab * cbrt(kRec2020ToOklabLms * c);
    lab = applyBands(lab);
    vec3 lms = kOklabLabToLms * lab;
    return kOklabLmsToRec2020 * (lms * lms * lms);
}

void main() {
    uvec3 id = gl_GlobalInvocationID;
    if (any(greaterThanEqual(id, uvec3(kGradeLutSize)))) {
        return;
    }
    vec3 t = vec3(id) / float(kGradeLutSize - 1u);
    vec3 inset = exp2(kLutMinEv + t * (kLutMaxEv - kLutMinEv));
    vec3 rec709 = kAgxInsetToRec709 * inset;
    vec3 display = agxDisplay(kRec2020ToRec709 *
                              gradeColor(kRec709ToRec2020 * rec709));
    imageStore(gradeLutOut, ivec3(id), vec4(display, 1.0));
}
