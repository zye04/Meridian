#version 460
#extension GL_GOOGLE_include_directive : require
#define MERIDIAN_CUSTOM_PUSH_CONSTANTS
#include "common.glsl"
#include "cull.glsl"
#include "terrain.glsl"
#include "voxel_lod.glsl"

// Cluster culling and LOD selection, one workgroup per work item (a group
// of clusters a BVH leaf reached, cluster_traverse.comp) and one thread per
// cluster. A cluster is drawn when Nanite's cut rule picks it
// (its coarser replacement's error is over the threshold on screen, its own
// is at or under), it is in the view frustum and not occluded. Occlusion
// follows Nanite's two passes: phase 0 tests against last frame's depth
// pyramid and queues what it hides for a retest against this frame's
// (phase kCullRetest), so nothing visible is dropped. Survivors append to
// the draw list of their mesh's bucket for mesh.mesh, voxel clusters to
// the phase's voxel list for voxel_bricks.comp.

layout(local_size_x = 64) in;

// A small alpha-masked cluster (grass, flowers, leaves) takes the terrain's
// sun visibility from here, one ray from its center, packed into its draw
// list entry's top 8 bits (kTerrainSunPerFragment: mesh.frag marches per
// fragment). Masked overdraw paid the heightfield march many times per
// pixel, and a grazing sun makes each march long (scene early 57 ms at 0.6
// degrees); here it runs once per cluster. The cluster is about the size of
// a terrain shadow's penumbra or smaller (the sun's 0.53 degrees times the
// occluder distance: 0.9 m at 100 m). Its point of the sun's disk is fixed
// per cluster, not per frame: a whole tuft flipping between lit and
// shadowed would flicker where per-pixel noise averages out, so the
// penumbra is a stable mix of lit and shadowed clusters instead.
const float kClusterTerrainSunRadius = 1.0;

uint terrainSunCode(MeshInfo mesh, vec3 world, float radius, uint clusterIndex,
                    uint instanceIndex) {
    if (cull.scene.shadowView != 0u) {
        return 0u;
    }
    if (mesh.drawBucket < 2u || mesh.drawBucket > 3u || radius > kClusterTerrainSunRadius) {
        return kTerrainSunPerFragment;
    }
    vec3 sun = cull.scene.sunDirection;
    // Below the horizon by more than the disk: every N.L test fails.
    if (sun.y < -sin(cull.scene.sunAngularRadius)) {
        return 0u;
    }
    vec3 origin = world;
    origin.y = max(origin.y, terrainHeight(cull.scene.terrain, origin.xz) + kShadowRayBias);
    uvec3 h = pcg3d(uvec3(instanceIndex, clusterIndex, 0u));
    vec3 direction = sunDiskDirection(cull.scene, float(h.x >> 8u) * (1.0 / 16777216.0),
                                      float(h.y >> 8u) * (1.0 / 16777216.0));
    float visibility = terrainShadowVisibility(cull.scene, origin);
    if (visibility >= 0.0) {
        return visibility > float(h.z >> 8u) * (1.0 / 16777216.0) ? 1u : 0u;
    }
    return terrainOccludes(cull.scene, origin, direction, kShadowRayLength) ? 0u : 1u;
}

// A voxel cluster: (instance, cluster) in the phase's voxel list, one
// voxel_bricks.comp workgroup each.
void drawVoxels(uint instanceIndex, uint clusterIndex) {
    uint phase = min(cull.phase, 1u);
    uint counter = kCounterVoxelDispatch + phase * 3u;
    uint slot = atomicAdd(cull.counters.counters[counter], 1u);
    if (slot >= kMaxVoxelInstances) {
        atomicAdd(cull.counters.counters[counter], uint(-1));
        atomicAdd(cull.counters.counters[kCounterVoxelDrops], 1u);
        atomicAdd(cull.counters.counters[kCounterOverflow], 1u);
        return;
    }
    cull.scene.voxelInstances.entries[phase * kMaxVoxelInstances + slot] =
        uvec2(instanceIndex, clusterIndex);
}

void draw(uint instanceIndex, uint clusterIndex, ClusterInfo cluster, vec3 world,
          float radius) {
    if (cluster.voxelEdge > 0.0) {
        // In a cascade too: voxel_bricks.comp lists its voxels as seen from
        // the sun and voxel_instance.mesh casts them.
        drawVoxels(instanceIndex, clusterIndex);
        return;
    }
    MeshInfo mesh = cull.scene.meshes.meshes[cluster.mesh];
    // Retested clusters are drawn in the late pass.
    uint list = (cull.scene.shadowView != 0u ? 0u : min(cull.phase, 1u)) * kDrawBuckets +
                mesh.drawBucket;
    uint slot = atomicAdd(cull.counters.counters[kCounterMeshTasks + list * 3u], 1u);
    if (slot >= kMaxDrawnClusters) {
        // The count is the mesh task count: keep it at the capacity.
        atomicAdd(cull.counters.counters[kCounterMeshTasks + list * 3u], uint(-1));
        countDrops(2u, 1u);
        return;
    }
    cull.scene.drawLists.entries[list * kMaxDrawnClusters + slot] =
        uvec2((instanceIndex & 0xFFFFFFu) | terrainSunCode(mesh, world, radius, clusterIndex,
                                             instanceIndex) << 24,
              clusterIndex);
    atomicAdd(cull.counters.counters[kCounterTriangles], cluster.triangleCount);
}

void retest() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= min(cull.counters.counters[kCounterRetest], kMaxRetestClusters)) {
        return;
    }
    uvec2 entry = cull.retest.entries[index];
    LoadedInstance instance = loadInstance(cull.scene, entry.x);
    ClusterInfo cluster = cull.scene.clusters.clusters[entry.y];
    vec3 world = (instance.transform * vec4(cluster.boundsCenter, 1.0)).xyz;
    float radius = cluster.boundsRadius * instance.scale;
    vec4 sphere = displayedSphere(world - cull.scene.cameraPosition, radius);
    if (!occluded(sphere, cull.scene.view)) {
        draw(entry.x, entry.y, cluster, world, radius);
    }
}

void main() {
    if (cull.phase == kCullRetest) {
        retest();
        return;
    }
    uint itemIndex = gl_WorkGroupID.x;
    if (itemIndex >= kMaxWorkItems) {
        return;
    }
    uvec2 item = cull.work.items[itemIndex];
    if (gl_LocalInvocationID.x > (item.y >> 26)) {
        return;
    }
    uint instanceIndex = item.x;
    uint clusterIndex = (item.y & 0x3FFFFFFu) + gl_LocalInvocationID.x;
    LoadedInstance instance = loadInstance(cull.scene, instanceIndex);
    ClusterInfo cluster = cull.scene.clusters.clusters[clusterIndex];
    mat4 transform = instance.transform;
    float scale = instance.scale;

    float threshold = cull.scene.lodErrorPixels;
    // With voxel LOD off, voxel clusters never draw and the triangles they
    // replace never give way (terminal).
    bool voxelLod = voxelLodAt(cull.scene, transform[3].xyz);
    if (!voxelLod && cluster.voxelEdge > 0.0) {
        return;
    }
    // A group whose members and replacement are both voxels switches at
    // kVoxelPixels times the threshold; the one where triangles give way to
    // voxels at the threshold, on both of its sides (CPU reference:
    // meridian::clusterThresholds).
    bool voxel = cluster.voxelEdge > 0.0;
    float selfThreshold = voxel ? threshold * kVoxelPixels : threshold;
    float refinedThreshold = voxel && cluster.vertexCount == 0u ? threshold * kVoxelPixels : threshold;
    // Terminal clusters carry FLT_MAX: always too coarse to replace.
    bool replacementTooCoarse =
        (!voxelLod && cluster.voxelEdge < 0.0) ||
        projectedError((transform * vec4(cluster.selfCenter, 1.0)).xyz,
                       cluster.selfRadius * scale, cluster.selfError * scale) >
            selfThreshold;
    bool fineEnough =
        cluster.refinedError < 0.0 ||
        projectedError((transform * vec4(cluster.refinedCenter, 1.0)).xyz,
                       cluster.refinedRadius * scale,
                       cluster.refinedError * scale) <= refinedThreshold;
    if (!replacementTooCoarse || !fineEnough) {
        return;
    }

    vec3 world = (transform * vec4(cluster.boundsCenter, 1.0)).xyz;
    float radius = cluster.boundsRadius * scale;
    vec4 sphere = displayedSphere(world - cull.scene.cameraPosition, radius);
    if (!inFrustum(sphere.xyz, sphere.w)) {
        return;
    }

    // Last frame's pyramid holds last frame's warp.
    if (occlusionEnabled() && cull.phase == 0u && cull.previousPyramid != 0u &&
        occluded(displayedSphere(world - cull.scene.previousCameraPosition, radius),
                 cull.scene.previousView)) {
        uint slot = atomicAdd(cull.counters.counters[kCounterRetest], 1u);
        if (slot >= kMaxRetestClusters) {
            // Dropping it could hide something visible: draw it now instead.
            draw(instanceIndex, clusterIndex, cluster, world, radius);
            return;
        }
        // One retest workgroup per 64 entries.
        if (slot % 64u == 0u) {
            atomicAdd(cull.counters.counters[kCounterRetestDispatch], 1u);
        }
        cull.retest.entries[slot] = uvec2(instanceIndex, clusterIndex);
        return;
    }
    if (occlusionEnabled() && cull.phase == 1u &&
        occluded(sphere, cull.scene.view)) {
        return;
    }
    draw(instanceIndex, clusterIndex, cluster, world, radius);
}
