#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "farfield.glsl"
#include "protovoxel.glsl"

// 64 voxels of a voxel list (voxel_bricks.comp; phase * 2 + band in
// pc.drawList) per workgroup, a thread each: the voxel is a camera-facing
// quad at its center, the Nanite Foliage way (rasterized, not marched). A
// cube seen along unit direction d (prototype space) covers v^2 (|dx| + |dy|
// + |dz|) on screen and its mean chord is v / (|dx| + |dy| + |dz|):
// voxel_bricks.comp drew it with the opacity of that chord, and the quad
// gets that area, so over many voxels the coverage matches the baked
// extinction. SHADOW (voxel_shadow.mesh): the same voxels as a cascade's
// depth-only casters.

layout(local_size_x = 64) in;
layout(triangles, max_vertices = 256, max_primitives = 128) out;

#ifndef SHADOW
// Flat: the voxel center relative to the camera (flat world), its packed
// voxel and occlusion word, the instance and the brick's pool index |
// terrain sun << 31, and the center in prototype space.
layout(location = 0) flat out vec3 outRelative[];
layout(location = 1) flat out uvec2 outVoxel[];
layout(location = 2) flat out uvec2 outBrick[];
layout(location = 3) flat out vec3 outLocal[];
#endif

void main() {
    SceneBuffer scene = pc.scene;
    uint list = pc.drawList;
    uint phase = list >> 1;
    uint count = min(scene.drawCounters.counters[kCounterVoxelQuads + list],
                     voxelQuadListCapacity(list));
    uint first = gl_WorkGroupID.x * 64u;
    uint n = first < count ? min(count - first, 64u) : 0u;
    SetMeshOutputsEXT(n * 4u, n * 2u);
    uint slot = gl_LocalInvocationIndex;
    if (slot >= n) {
        return;
    }
    uint q = voxelQuadListStart(list) + first + slot;
    uint entry = scene.voxelInstances.entries[q >> 1][q & 1u];
    uvec2 brick = scene.voxelInstances.entries[kVoxelBrickListBase + phase * kMaxVoxelBricks +
                                               (entry >> 6)];
    uint i = entry & 63u;
    uvec2 tree = scene.voxelInstances.entries[brick.x];
    LoadedInstance instance = loadInstance(scene, tree.x);
    ProtoVoxelBuffer pv = scene.protoVoxels;
    PrototypeVoxels info = pv.prototypes.prototypes[instance.meshOrPrototype];
    float v = pv.levels.levels[info.firstLevel + tree.y].voxelSize;
    uint pool = brick.y & 0x7FFFFFFFu;
    uint coords = pv.brickCoords.voxels[pool];
    ivec3 voxel = ivec3(coords & 0x3FFu, (coords >> 10) & 0x3FFu, coords >> 20) * 4 +
                  ivec3(i & 3u, (i >> 2) & 3u, i >> 4);
    vec3 local = info.lo + (vec3(voxel) + 0.5) * v;
    vec3 relative = (instance.transform * vec4(local, 1.0)).xyz - scene.cameraPosition;
#ifdef SHADOW
    vec3 view = normalize(transpose(mat3(instance.transform)) * -scene.sunDirection);
#else
    vec3 view = normalize(transpose(mat3(instance.transform)) * relative);
#endif
    float spread = abs(view.x) + abs(view.y) + abs(view.z);

#ifdef SHADOW
    // Depth only, in the cascade's orthographic view along the sun: the quad
    // spans the light basis' u and v.
    float halfWorld = 0.5 * v * instance.scale * sqrt(spread);
    vec3 u = scene.sunShadows.u * halfWorld, w = scene.sunShadows.v * halfWorld;
    for (uint corner = 0u; corner < 4u; ++corner) {
        vec2 offset = vec2(corner & 1u, corner >> 1) * 2.0 - 1.0;
        gl_MeshVerticesEXT[slot * 4u + corner].gl_Position =
            scene.viewProjection * vec4(relative + offset.x * u + offset.y * w, 1.0);
    }
#else
    vec4 center = scene.viewProjection * displayedPosition(scene, relative);
    vec2 halfSize = 0.5 * v * instance.scale * sqrt(spread) * abs(scene.projectionScale);
    uvec2 packed = uvec2(pv.voxels.voxels[pool * 64u + i], pv.occlusion.voxels[pool * 64u + i]);
    for (uint corner = 0u; corner < 4u; ++corner) {
        uint vertex = slot * 4u + corner;
        vec2 offset = vec2(corner & 1u, corner >> 1) * 2.0 - 1.0;
        gl_MeshVerticesEXT[vertex].gl_Position = center + vec4(offset * halfSize, 0.0, 0.0);
        outRelative[vertex] = relative;
        outVoxel[vertex] = packed;
        outBrick[vertex] = uvec2(tree.x, brick.y);
        outLocal[vertex] = local;
    }
#endif
    gl_PrimitiveTriangleIndicesEXT[slot * 2u] = uvec3(0u, 1u, 3u) + slot * 4u;
    gl_PrimitiveTriangleIndicesEXT[slot * 2u + 1u] = uvec3(0u, 3u, 2u) + slot * 4u;
}
