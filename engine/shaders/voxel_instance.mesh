#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "voxel_lod.glsl"
#define DEBUG_ID_CONSTANTS_ONLY
#include "debug_id.glsl"
#undef DEBUG_ID_CONSTANTS_ONLY

// 64 voxels of a phase's voxel list (voxel_bricks.comp; phase * 2 in
// pc.drawList) per workgroup, a thread each: the voxel is a camera-facing
// quad at its centre, the Nanite Foliage way (rasterized, not marched). A
// cube seen along unit direction d (mesh space) covers v^2 (|dx| + |dy| +
// |dz|) on screen and its mean chord is v / (|dx| + |dy| + |dz|):
// voxel_bricks.comp drew it with the opacity of that chord, and the quad
// gets that area, so over many voxels the coverage matches the voxels'
// (with --voxel-coverage, voxel_lod.glsl: a fraction of it).

layout(local_size_x = 64) in;
layout(triangles, max_vertices = 256, max_primitives = 128) out;

// Flat: the voxel centre relative to the camera (flat world), its packed
// voxel and (instance, terrain sun, axis word, cluster).
layout(location = 0) flat out vec3 outRelative[];
layout(location = 1) flat out uvec4 outVoxel[];
layout(location = 2) flat out uvec4 outInfo[];

void main() {
    SceneBuffer scene = pc.scene;
    uint list = pc.drawList;
    uint count = min(scene.drawCounters.counters[kCounterVoxelQuads + list], kMaxVoxelQuads);
    uint first = gl_WorkGroupID.x * 64u;
    uint n = first < count ? min(count - first, 64u) : 0u;
    SetMeshOutputsEXT(n * 4u, n * 2u);
    uint slot = gl_LocalInvocationIndex;
    if (slot >= n) {
        return;
    }
    uvec2 entry = scene.voxelInstances.entries[voxelQuadListStart(list) + first + slot];
    uint i = entry.y & 63u;
    uvec2 clusterEntry = scene.voxelInstances.entries[entry.x & 0x7FFFFFFFu];
    LoadedInstance instance = loadInstance(scene, clusterEntry.x);
    ClusterInfo cluster = scene.clusters.clusters[clusterEntry.y];
    VoxelPoolBuffer pools = scene.voxelPools;
    float v = cluster.voxelEdge;
    VoxelBrick brick = pools.bricks.bricks[entry.y >> 6];
    uint voxel = voxelSlot(brick, i);
    vec3 local = (vec3(voxelCoords(brick, i)) + 0.5) * v;
    vec3 relative = (instance.transform * vec4(local, 1.0)).xyz - scene.cameraPosition;
    // A cascade looks along the sun, orthographically: the quad faces the
    // sun and its size is the projection's scale per metre, not over depth.
    bool cascade = scene.shadowView != 0u;
    vec3 view = normalize(transpose(mat3(instance.transform)) *
                          (cascade ? -scene.sunDirection : relative));
    float spread = abs(view.x) + abs(view.y) + abs(view.z);

    vec4 center = scene.viewProjection * displayedPosition(scene, relative);
    mat4 vp = scene.viewProjection;
    vec2 perMetre = cascade ? vec2(length(vec3(vp[0][0], vp[1][0], vp[2][0])),
                                   length(vec3(vp[0][1], vp[1][1], vp[2][1])))
                            : abs(scene.projectionScale);
    vec2 halfSize = 0.5 * v * instance.scale * sqrt(spread) * perMetre;
    uvec4 packed = pools.voxels.voxels[voxel];
    // The view's coverage rule (voxel_bricks.comp drew it with its chance):
    // the quad at area fraction a, moved inside the full quad for
    // AreaOffset.
    uint rule = voxelCoverageRule(scene.voxelCoverage, cascade);
    float f = voxelViewOpacity(voxelDepths(packed), view);
    rule = voxelRuleFor(rule, packed, f);
    if (rule != kVoxelCoverageHash) {
        vec2 offset = voxelQuadOffset(rule, f, voxelHash(clusterEntry.x, brick, v, cluster.firstVertex, i));
        center.xy += offset * halfSize;
        float pixels = voxelUsesPixels(rule) ? voxelQuadPixels(scene, relative, view, v * instance.scale) : 0.0;
        halfSize *= sqrt(voxelAreaFraction(rule, f, pixels));
    }
    uvec4 info = uvec4(clusterEntry.x, entry.x >> 31, pools.axis.words[voxel], clusterEntry.y);
    for (uint corner = 0u; corner < 4u; ++corner) {
        uint vertex = slot * 4u + corner;
        vec2 offset = vec2(corner & 1u, corner >> 1) * 2.0 - 1.0;
        gl_MeshVerticesEXT[vertex].gl_Position = center + vec4(offset * halfSize, 0.0, 0.0);
        outRelative[vertex] = relative;
        outVoxel[vertex] = packed;
        outInfo[vertex] = info;
    }
    gl_PrimitiveTriangleIndicesEXT[slot * 2u] = uvec3(0u, 1u, 3u) + slot * 4u;
    gl_PrimitiveTriangleIndicesEXT[slot * 2u + 1u] = uvec3(0u, 3u, 2u) + slot * 4u;
#ifdef DEBUG_ID
    // Solo/hide in the mesh shader keeps the fragment shader free of
    // discard, so it keeps early depth tests despite its debug stores.
    bool rejected = debugFilterRejects(scene.debugFilter, clusterEntry.x, ~0u);
    gl_MeshPrimitivesEXT[slot * 2u].gl_CullPrimitiveEXT = rejected;
    gl_MeshPrimitivesEXT[slot * 2u + 1u].gl_CullPrimitiveEXT = rejected;
#endif
}
