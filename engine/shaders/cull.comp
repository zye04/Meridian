#version 460
#extension GL_GOOGLE_include_directive : require
#define MERIDIAN_CUSTOM_PUSH_CONSTANTS
#include "common.glsl"
#include "cull.glsl"

// GPU-driven instance culling, one thread per instance, in two phases
// around a depth pyramid (two-phase occlusion culling, as in niagara and
// Nanite):
//   0: what was visible last frame, testing only the view frustum;
//   1: everything against the pyramid of phase 0's depth: what is visible
//      but wasn't processed in phase 0, recording visibility for the next
//      frame.
// Survivors append work items covering their clusters; cluster_cull.comp
// then culls and LOD-selects the clusters themselves.

layout(local_size_x = 64) in;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= cull.scene.instanceCount) {
        return;
    }
    InstanceData instance = cull.scene.instances.instances[index];
    MeshInfo mesh = cull.scene.meshes.meshes[instance.meshIndex];
    if (mesh.drawBucket == kDrawBucketBlended) {
        return;
    }

    vec3 center = (instance.transform * vec4(mesh.boundsCenter, 1.0)).xyz;
    float radius = mesh.boundsRadius * maxScale(instance.transform);
    bool visibleInFrustum = inFrustum(center, radius);

    bool wasVisible = cull.visibility.visible[index] != 0u;
    if (cull.phase == 0u) {
        if (cull.occlusion == 0u || !wasVisible || !visibleInFrustum) {
            return;
        }
    } else {
        bool visible = visibleInFrustum &&
                       (cull.occlusion == 0u || !occluded(center, radius, cull.scene.view));
        cull.visibility.visible[index] = visible ? 1u : 0u;
        // Instances processed in phase 0 aren't processed again.
        if (!visible || (cull.occlusion != 0u && wasVisible)) {
            return;
        }
    }

    atomicAdd(cull.counters.counters[kCounterInstances], 1u);
    uint itemCount = (mesh.clusterCount + kClustersPerWorkItem - 1u) / kClustersPerWorkItem;
    uint first = atomicAdd(cull.counters.counters[cull.phase * 3u], itemCount);
    // The count is the cluster cull's dispatch size: give back what doesn't
    // fit so it ends at the capacity.
    uint end = min(first + itemCount, kMaxWorkItems);
    uint dropped = itemCount - (end > first ? end - first : 0u);
    if (dropped > 0u) {
        atomicAdd(cull.counters.counters[cull.phase * 3u], -dropped);
        atomicAdd(cull.counters.counters[kCounterOverflow], dropped);
        itemCount -= dropped;
    }
    for (uint i = 0u; i < itemCount; ++i) {
        uint offset = i * kClustersPerWorkItem;
        uint count = min(kClustersPerWorkItem, mesh.clusterCount - offset);
        cull.work.items[first + i] =
            uvec2(index, (mesh.firstCluster + offset) | ((count - 1u) << 26));
    }
}
