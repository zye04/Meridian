#version 460
#extension GL_GOOGLE_include_directive : require
#define MERIDIAN_CUSTOM_PUSH_CONSTANTS
#include "common.glsl"
#include "cull.glsl"
#include "farfield.glsl"

// GPU-driven instance culling, one workgroup per chunk of up to 64
// instances (cell_cull.comp emits them), one thread per instance, in two
// phases around a depth pyramid (two-phase occlusion culling, as in niagara
// and Nanite):
//   0: what was visible last frame, testing only the view frustum;
//   1: everything against the pyramid of phase 0's depth: what is visible
//      but wasn't processed in phase 0, recording visibility for the next
//      frame.
// Placed instances are tested with their prototype's bounds and draw
// distance. Survivors seed the cluster BVH traversal
// (cluster_traverse.comp) with the root of every DAG level of their meshes
// that can hold the LOD cut, voxel levels included (cluster_cull.comp lists
// the voxel clusters the cut picks).

layout(local_size_x = 64) in;

// Seeds the root of each DAG level that can hold the LOD cut (must match
// meridian::selectClustersBvh): not when even the level's smallest refined
// error projects over the threshold from as far as any refined sphere can
// be, nor when its largest self error projects at or under it.
void seedTraversal(uint id, LoadedInstance instance, MeshInfo mesh) {
    SceneBuffer scene = cull.scene;
    float pixelsPerError = abs(scene.projectionScale.y) * 0.5 / scene.inverseResolution.y;
    for (uint i = 0u; i < mesh.levelCount; ++i) {
        ClusterLevelGpu level = scene.clusterLevels.levels[mesh.firstLevel + i];
        ClusterNodeInfo root = scene.clusterNodes.nodes[level.rootNode];
        vec3 center = (instance.transform * vec4(root.lodCenter, 1.0)).xyz;
        float farthest = length(center - scene.cameraPosition) +
                         (root.lodRadius - level.minGroupRadius) * instance.scale;
        float finest = scene.orthoPixelsPerMeter > 0.0
                           ? level.minError * instance.scale * scene.orthoPixelsPerMeter
                           : level.minError * instance.scale / max(farthest, scene.nearPlane) *
                                 pixelsPerError;
        // With voxel LOD off the triangles under voxel levels never give way
        // (cluster_cull.comp), so no level is too coarse to seed.
        // Voxel levels switch at kVoxelPixels times the threshold.
        if (finest <= scene.lodErrorPixels * kVoxelPixels &&
            (!voxelLodAt(scene, instance.transform[3].xyz) ||
             projectedError(center, root.lodRadius * instance.scale,
                            level.maxError * instance.scale) > scene.lodErrorPixels)) {
            if (!pushNode(cull.phase, 0u, uvec2(id, level.rootNode))) {
                countDrops(4u, 1u);
            }
        }
    }
}

void main() {
    if (gl_WorkGroupID.x >= kMaxChunks) {
        return;
    }
    uvec2 chunk = cull.chunks.chunks[gl_WorkGroupID.x];
    if (gl_LocalInvocationID.x >= (chunk.y & ~kChunkCellWasVisible)) {
        return;
    }
    uint id = chunk.x + gl_LocalInvocationID.x;
    SceneBuffer scene = cull.scene;
    LoadedInstance instance = loadInstance(scene, id);
    if (instance.placed && instance.scale <= 0.0) {
        // Thinned out (streamed): not visible, and not kept visible.
        if (cull.phase == 1u && scene.shadowView == 0u) {
            cull.visibility.visible[id] = 0u;
        }
        return;
    }
    vec3 center;
    float radius;
    float maxDistance = 0.0;
    PrototypeInfo prototype;
    if (instance.placed) {
        prototype = scene.prototypes.prototypes[instance.meshOrPrototype];
        center = prototype.boundsCenter;
        radius = prototype.boundsRadius;
        maxDistance = prototype.maxDrawDistance;
    } else {
        MeshInfo mesh = scene.meshes.meshes[instance.meshOrPrototype];
        if (mesh.drawBucket == kDrawBucketBlended) {
            return;
        }
        center = mesh.boundsCenter;
        radius = mesh.boundsRadius;
    }

    vec3 relative = (instance.transform * vec4(center, 1.0)).xyz - scene.cameraPosition;
    vec4 sphere = displayedSphere(relative, radius * instance.scale);
    bool visibleInFrustum = inFrustum(sphere.xyz, sphere.w) &&
                            (maxDistance == 0.0 ||
                             length(relative) - radius * instance.scale <=
                                 maxDistance + scene.shadowDrawMargin);

    bool occlusion = occlusionEnabled();
    bool wasVisible = occlusion && cull.visibility.visible[id] != 0u;
    if (cull.phase == 0u) {
        if (!occlusion || !wasVisible || !visibleInFrustum) {
            return;
        }
    } else {
        bool visible = visibleInFrustum && (!occlusion || !occluded(sphere, scene.view));
        if (scene.shadowView == 0u) {
            cull.visibility.visible[id] = visible ? 1u : 0u;
        }
        // Instances processed in phase 0 aren't processed again.
        bool processed = occlusion && wasVisible &&
                         (chunk.y & kChunkCellWasVisible) != 0u;
        if (!visible || processed) {
            return;
        }
    }

    atomicAdd(cull.counters.counters[kCounterInstances], 1u);
    if (!instance.placed) {
        seedTraversal(id, instance, scene.meshes.meshes[instance.meshOrPrototype]);
        return;
    }
    for (uint i = 0u; i < prototype.meshCount; ++i) {
        seedTraversal(id, instance,
                      scene.meshes.meshes[scene.prototypeMeshes.meshes[prototype.firstMesh + i]]);
    }
}
