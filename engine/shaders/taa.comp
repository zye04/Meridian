#version 460
#extension GL_GOOGLE_include_directive : require
#include "exposure.glsl"

// Temporal anti-aliasing resolve: blends this frame (rendered with a
// sub-pixel jitter) into an accumulated history. Following the standard
// recipe (Karis 2014, Salvi 2016, Playdead INSIDE): reprojection by motion
// vectors, bicubic history sampling, variance clipping in YCoCg, and
// luminance-weighted blending to suppress flicker. In motion the history is
// kept shorter (see main); sharpen.comp writes the output.

layout(local_size_x = 8, local_size_y = 8) in;

// Must match TaaUpscaler (taa_upscaler.cpp).
layout(set = 0, binding = 0) uniform sampler2D sceneColor;
layout(set = 0, binding = 1) uniform sampler2D motion;
layout(set = 0, binding = 2) uniform sampler2D historyPrevious;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D historyNext;

layout(push_constant) uniform TaaConstants {
    ExposureBuffer exposure;
    uint historyValid;
    uint pad;
    vec2 jitter;
} taa;

// Current-frame weight when still; motion raises it toward the maximum
// (see main). Values: docs/decisions.md (TAA v2, then the native TAA
// entries of 2026-11-21).
const float kCurrentWeight = 0.0625;
const float kMaxCurrentWeight = 0.2;
// Motion (render pixels per frame) that reaches the maximum.
const float kMotionPixels = 0.25;
const float kMagnificationPower = 6.0;
// A tighter clip in motion (0.75) pulls the history toward the blurry
// neighbourhood mean and measured softer in every view.
const float kVarianceGamma = 1.0;
// Keys cubic parameter of the history resampling: -1 keeps more detail per
// resample than Catmull-Rom's -0.5, so a longer history in motion stays
// sharp; the variance clip bounds its overshoot.
const float kHistoryCubic = -1.0;
// 1 / (2 sigma^2) of the current frame's reconstruction filter, sigma 0.47 px.
const float kReconstructionFalloff = 2.26;

vec3 toYCoCg(vec3 c) {
    return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b,
                0.5 * c.r - 0.5 * c.b,
                -0.25 * c.r + 0.5 * c.g - 0.25 * c.b);
}

vec3 fromYCoCg(vec3 c) {
    return vec3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z);
}

// 9-tap bicubic (MJP's Catmull-Rom, via PlayCanvas, with Keys' parameter
// a): sharper than bilinear, which would blur the history every frame.
vec3 sampleHistory(vec2 uv, vec2 texSize) {
    vec2 samplePos = uv * texSize;
    vec2 texPos1 = floor(samplePos - 0.5) + 0.5;
    vec2 f = samplePos - texPos1;

    const float a = kHistoryCubic;
    vec2 g = 1.0 - f;
    vec2 w0 = a * f * g * g;
    vec2 w1 = ((a + 2.0) * f - (a + 3.0)) * f * f + 1.0;
    vec2 w2 = ((a + 2.0) * g - (a + 3.0)) * g * g + 1.0;
    vec2 w3 = a * f * f * g;
    vec2 w12 = w1 + w2;
    vec2 offset12 = w2 / w12;

    vec2 texPos0 = (texPos1 - 1.0) / texSize;
    vec2 texPos3 = (texPos1 + 2.0) / texSize;
    vec2 texPos12 = (texPos1 + offset12) / texSize;

    vec3 result = vec3(0.0);
    result += textureLod(historyPrevious, vec2(texPos0.x, texPos0.y), 0.0).rgb * w0.x * w0.y;
    result += textureLod(historyPrevious, vec2(texPos12.x, texPos0.y), 0.0).rgb * w12.x * w0.y;
    result += textureLod(historyPrevious, vec2(texPos3.x, texPos0.y), 0.0).rgb * w3.x * w0.y;
    result += textureLod(historyPrevious, vec2(texPos0.x, texPos12.y), 0.0).rgb * w0.x * w12.y;
    result += textureLod(historyPrevious, vec2(texPos12.x, texPos12.y), 0.0).rgb * w12.x * w12.y;
    result += textureLod(historyPrevious, vec2(texPos3.x, texPos12.y), 0.0).rgb * w3.x * w12.y;
    result += textureLod(historyPrevious, vec2(texPos0.x, texPos3.y), 0.0).rgb * w0.x * w3.y;
    result += textureLod(historyPrevious, vec2(texPos12.x, texPos3.y), 0.0).rgb * w12.x * w3.y;
    result += textureLod(historyPrevious, vec2(texPos3.x, texPos3.y), 0.0).rgb * w3.x * w3.y;
    return result;
}

// Pulls the history toward the center of the neighborhood box until it fits
// (Playdead), instead of clamping each channel, which shifts hue.
vec3 clipToBox(vec3 history, vec3 boxMin, vec3 boxMax) {
    vec3 center = 0.5 * (boxMax + boxMin);
    vec3 extents = 0.5 * (boxMax - boxMin) + 1e-6;
    vec3 offset = history - center;
    vec3 units = abs(offset / extents);
    float maxUnit = max(units.x, max(units.y, units.z));
    return maxUnit > 1.0 ? center + offset / maxUnit : history;
}

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

// d(motion in pixels)/dpixel along `axis`: of the two one-sided
// differences, the smaller, so a depth edge on one side (where motion jumps)
// doesn't read as magnification.
vec2 motionDerivative(ivec2 texel, ivec2 axis, vec2 center, ivec2 renderSize) {
    vec2 ahead = texelFetch(motion, clamp(texel + axis, ivec2(0), renderSize - 1), 0).xy - center;
    vec2 behind = center - texelFetch(motion, clamp(texel - axis, ivec2(0), renderSize - 1), 0).xy;
    return (dot(ahead, ahead) < dot(behind, behind) ? ahead : behind) * vec2(renderSize);
}

void main() {
    // Output pixels are display pixels; the scene colour and motion are at
    // the render size, which may be smaller.
    ivec2 size = imageSize(historyNext);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    ivec2 renderSize = textureSize(sceneColor, 0);

    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);
    // The render texel under uv; exactly `pixel` when the sizes match.
    ivec2 texel = ivec2((vec2(pixel) + 0.5) * vec2(renderSize) / vec2(size));
    vec3 current = textureLod(sceneColor, uv, 0.0).rgb;

    vec2 motionUv = texelFetch(motion, texel, 0).xy;
    vec2 previousUv = uv + motionUv;
    if (taa.historyValid == 0u || any(lessThan(previousUv, vec2(0.0))) ||
        any(greaterThan(previousUv, vec2(1.0)))) {
        imageStore(historyNext, pixel, vec4(current, 1.0));
        return;
    }

    // Resampling the history at a fractional offset blurs it a little every
    // frame, worst halfway between texels; in motion that compounds, so the
    // history is kept shorter there.
    float moving = clamp(length(motionUv * vec2(renderSize)) / kMotionPixels, 0.0, 1.0);
    vec2 f = fract(previousUv * vec2(size) - 0.5);
    vec2 subpixel = 4.0 * f * (1.0 - f);
    float currentWeightBase =
        mix(kCurrentWeight, kMaxCurrentWeight, moving * max(subpixel.x, subpixel.y));

    // Where the reprojection shrinks area (forward motion), the history is
    // magnified: older, coarser detail stretched over more pixels. The
    // Jacobian determinant of current -> previous pixel measures it.
    vec2 dx = motionDerivative(texel, ivec2(1, 0), motionUv, renderSize);
    vec2 dy = motionDerivative(texel, ivec2(0, 1), motionUv, renderSize);
    float jacobian = (1.0 + dx.x) * (1.0 + dy.y) - dx.y * dy.x;
    if (jacobian < 1.0) {
        currentWeightBase = max(currentWeightBase,
            1.0 - 0.9 * pow(max(jacobian, 0.0), kMagnificationPower));
    }

    // The current frame, reconstructed at the pixel centre from the 3x3's
    // jittered samples (Gaussian of each sample's distance, sigma 0.47 px,
    // Karis 2014's fit of Blackman-Harris): the raw sample's sub-pixel
    // offset changes every frame and reads as shimmer in motion.
    vec3 mean = vec3(0.0);
    vec3 meanSquared = vec3(0.0);
    vec3 filtered = vec3(0.0);
    float filteredWeight = 0.0;
    vec2 center = uv * vec2(renderSize) - taa.jitter;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            ivec2 p = clamp(texel + ivec2(x, y), ivec2(0), renderSize - 1);
            vec3 rgb = texelFetch(sceneColor, p, 0).rgb;
            vec2 d = vec2(texel + ivec2(x, y)) + 0.5 - center;
            float w = exp(-kReconstructionFalloff * dot(d, d));
            filtered += rgb * w;
            filteredWeight += w;
            vec3 c = toYCoCg(rgb);
            mean += c;
            meanSquared += c * c;
        }
    }
    current = filtered / filteredWeight;
    mean /= 9.0;
    vec3 sigma = sqrt(max(meanSquared / 9.0 - mean * mean, 0.0));

    // The history is pre-exposed by the exposure the previous frame used.
    vec3 history = max(sampleHistory(previousUv, vec2(size)), 0.0) *
                   (taa.exposure.exposure / taa.exposure.previousExposure);
    history = fromYCoCg(clipToBox(toYCoCg(history), mean - kVarianceGamma * sigma,
                                  mean + kVarianceGamma * sigma));

    float currentWeight = currentWeightBase / (1.0 + luminance(current));
    float historyWeight = (1.0 - currentWeightBase) / (1.0 + luminance(history));
    vec3 result = (current * currentWeight + history * historyWeight) /
                  (currentWeight + historyWeight);

    imageStore(historyNext, pixel, vec4(result, 1.0));
}
