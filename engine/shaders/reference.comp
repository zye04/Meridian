#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
// Reference path tracer (--reference): one sample per pixel per dispatch,
// accumulated over frames into sum / count, written to the upscaler's
// output so the capture path saves it. Surfaces only: the sky, haze, cloud
// shadow and sun transmittance are the raster path's lookups.
#define SURFACE_ALL
#define MERIDIAN_CUSTOM_PUSH_CONSTANTS
#define SHADING_PIXEL shadingPixel
#include "common.glsl"

// Must match ReferenceConstants in gpu_types.h.
layout(buffer_reference, std430) buffer ReferenceAccumulation {
    vec4 pixels[];
};

layout(push_constant) uniform ReferenceConstants {
    SceneBuffer scene;
    // Per pixel: rgb sum, sample count in alpha; luminance sum of squares in
    // the second's red (noise).
    ReferenceAccumulation sum;
    ReferenceAccumulation squares;
    uint frame;
    // kReferenceRadiance, kReferenceAlbedo, the furnace modes.
    uint mode;
    vec3 cameraRight;
    float tanHalfFovY;
    vec3 cameraUp;
    float aspect;
    vec3 cameraForward;
    uint width;
    uint height;
} pc;

vec2 shadingPixel;

#include "atmosphere.glsl"
#include "material.glsl"
#include "terrain.glsl"
#include "lighting.glsl"
#include "placement.glsl"
#include "surface.glsl"
#include "ray_hit.glsl"

layout(set = 2, binding = 0, rgba16f) uniform writeonly image2D outputImage;

layout(local_size_x = 8, local_size_y = 8) in;

// ReferenceMode in renderer.h.
const uint kReferenceRadiance = 0u;
const uint kReferenceAlbedo = 1u;
const uint kReferenceWhite = 2u;
const uint kReferenceLeaf = 3u;
const uint kReferenceSun = 4u;
const float kRayLength = 1.0e6;

// Uniform in [0, 1) from the pixel, the frame and a per-use index.
vec2 random2(uvec2 pixel, uint index) {
    uvec3 h = pcg3d(uvec3(pixel, pc.frame * 64u + index));
    return vec2(h.xy >> 8u) * (1.0 / 16777216.0);
}

// The hit's material as the raster path evaluates it.
Surface hitSurface(RayHit hit) {
    surfaceIn.relativePosition = hit.position - pc.scene.cameraPosition;
    surfaceIn.worldPosition = hit.position;
    surfaceIn.dpdx = vec3(0.0);
    surfaceIn.dpdy = vec3(0.0);
    surfaceIn.uv = hit.uv;
    surfaceIn.tangent = hit.tangent;
    surfaceIn.tint = hit.tint;
    surfaceIn.height = hit.height;
    surfaceIn.streamFade = 1.0;
    surfaceIn.crownVisibility = 1.0;
    if (hit.terrain) {
        vec3 normal = terrainNormal();
        return pc.scene.terrain.enabled != 0u ? terrainSurface(normal) : proceduralTerrain(normal);
    }
    return materialSurface(pc.scene.materials.materials[hit.materialIndex], hit.normal);
}

// What mesh.frag writes to the diffuse albedo guide: the reflected share.
vec3 diffuseAlbedo(RayHit hit, Surface s) {
    vec3 albedo = s.baseColor * (1.0 - s.metallic);
    if (!hit.terrain) {
        albedo *= 1.0 - pc.scene.materials.materials[hit.materialIndex].diffuseTransmission;
    }
    return albedo;
}

struct Lobes {
    vec3 diffuse;      // reflected Lambert albedo, (1 - f) x base x (1 - metallic)
    vec3 transmitted;  // f x transmission colour x (1 - metallic), Lambert on the back
    vec3 f0;
    float a;           // GGX alpha
    bool specular;
};

// The raster path's BSDF (lighting.glsl, mesh.frag): Lambert front, KHR
// diffuse transmission back, GGX specular with energy compensation; the
// raster's occlusion approximations (material AO, micro, crown, plant base)
// are left out: the path tracer sees the geometry they stand for.
Lobes hitLobes(RayHit hit, Surface s) {
    Lobes l;
    float f = 0.0;
    vec3 transmissionColor = vec3(0.0);
    if (!hit.terrain) {
        Material m = pc.scene.materials.materials[hit.materialIndex];
        f = m.diffuseTransmission;
        transmissionColor = m.diffuseTransmissionColor * hit.tint;
        if (m.diffuseTransmissionColorTexture != kNoTexture) {
            transmissionColor *=
                textureLod(textures[nonuniformEXT(m.diffuseTransmissionColorTexture)], hit.uv, 0.0).rgb;
        }
    }
    l.specular = true;
    if (pc.mode == kReferenceWhite || pc.mode == kReferenceLeaf || pc.mode == kReferenceSun) {
        s.baseColor = vec3(1.0);
        s.metallic = 0.0;
        l.specular = false;
        f = pc.mode == kReferenceLeaf && f > 0.0 ? 0.5 : 0.0;
        transmissionColor = vec3(1.0);
    }
    l.diffuse = s.baseColor * (1.0 - s.metallic) * (1.0 - f);
    l.transmitted = transmissionColor * (f * (1.0 - s.metallic));
    l.f0 = mix(vec3(0.04), s.baseColor, s.metallic);
    float roughness = clamp(s.perceptualRoughness, kMinPerceptualRoughness, 1.0);
    l.a = roughness * roughness;
    return l;
}

vec3 specularBrdf(Lobes l, vec3 N, vec3 V, vec3 L, vec3 energyCompensation) {
    vec3 H = normalize(V + L);
    float NoV = max(dot(N, V), 1e-4);
    float NoL = clamp(dot(N, L), 0.0, 1.0);
    return distributionGgx(clamp(dot(N, H), 0.0, 1.0), l.a) *
           visibilitySmithGgxCorrelated(NoV, NoL, l.a) *
           fresnelSchlick(l.f0, clamp(dot(L, H), 0.0, 1.0)) * energyCompensation;
}

mat3 basisAround(vec3 n) {
    vec3 t = normalize(cross(abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0), n));
    return mat3(t, cross(n, t), n);
}

vec3 cosineDirection(vec3 n, vec2 u) {
    float r = sqrt(u.x);
    float phi = 2.0 * kPi * u.y;
    return basisAround(n) * vec3(r * cos(phi), r * sin(phi), sqrt(max(1.0 - u.x, 0.0)));
}

// GGX visible normals (Heitz 2018), V in the local frame of n.
vec3 sampleGgxVisibleNormal(vec3 n, vec3 V, float a, vec2 u) {
    mat3 frame = basisAround(n);
    vec3 v = transpose(frame) * V;
    vec3 vh = normalize(vec3(a * v.x, a * v.y, v.z));
    float lensq = vh.x * vh.x + vh.y * vh.y;
    vec3 t1 = lensq > 0.0 ? vec3(-vh.y, vh.x, 0.0) / sqrt(lensq) : vec3(1.0, 0.0, 0.0);
    vec3 t2 = cross(vh, t1);
    float r = sqrt(u.x);
    float phi = 2.0 * kPi * u.y;
    float p1 = r * cos(phi);
    float p2 = r * sin(phi);
    float sv = 0.5 * (1.0 + vh.z);
    p2 = (1.0 - sv) * sqrt(max(1.0 - p1 * p1, 0.0)) + sv * p2;
    vec3 nh = p1 * t1 + p2 * t2 + sqrt(max(1.0 - p1 * p1 - p2 * p2, 0.0)) * vh;
    return frame * normalize(vec3(a * nh.x, a * nh.y, max(nh.z, 0.0)));
}

float smithG1(float NoX, float a) {
    float a2 = a * a;
    return 2.0 * NoX / (NoX + sqrt(a2 + (1.0 - a2) * NoX * NoX));
}

// TLAS (alpha-tested) and heightfield between `origin` and the sun.
float sunRayVisibility(vec3 origin, vec3 direction) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, accelerationStructureEXT(pc.scene.tlas),
                          gl_RayFlagsTerminateOnFirstHitEXT,
                          kShadowCasterMask | kFarFieldCasterMask, origin, 0.0, direction,
                          kShadowRayLength);
    while (rayQueryProceedEXT(query)) {
        if (rayQueryGetIntersectionTypeEXT(query, false) ==
                gl_RayQueryCandidateIntersectionTriangleEXT &&
            alphaTestCandidate(query)) {
            rayQueryConfirmIntersectionEXT(query);
        }
    }
    if (rayQueryGetIntersectionTypeEXT(query, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        return 0.0;
    }
    return terrainOccludes(pc.scene, origin, direction, kShadowRayLength) ? 0.0 : 1.0;
}

// Sun irradiance at `world` relative to the sun's illuminance: atmosphere
// transmittance and cloud shadow, as the raster path's sunAtSurface.
vec3 sunAt(vec3 world) {
    vec3 p = atmospherePosition(world);
    float height = length(p);
    return transmittanceToSun(height, dot(p / height, pc.scene.sunDirection)) * cloudShadow(world);
}

// The sky along a ray that leaves the scene, as the raster ambient reads it:
// the sky-view LUT behind the sky capture's clouds. No sun disk (sampled by
// next-event estimation only).
vec3 skyAlong(vec3 origin, vec3 direction) {
    if (pc.mode == kReferenceWhite || pc.mode == kReferenceLeaf) {
        return vec3(1.0);
    }
    if (pc.mode == kReferenceSun) {
        return vec3(0.0);
    }
    vec4 clouds = skyCaptureAt(direction);
    return skyLuminance(atmospherePosition(origin), direction) * clouds.a + clouds.rgb;
}

vec3 offsetAlong(RayHit hit, vec3 direction) {
    float eps = 1.0e-3 + 1.0e-5 * hit.t;
    return hit.position + hit.geometricNormal * (dot(direction, hit.geometricNormal) >= 0.0 ? eps : -eps);
}

vec3 tracePath(vec3 origin, vec3 direction, uvec2 pixel) {
    bool furnace = pc.mode != kReferenceRadiance;
    uint maxBounces = furnace ? 256u : 16u;
    bool sunOn = pc.mode == kReferenceRadiance || pc.mode == kReferenceSun;
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    vec3 primaryRelative = vec3(0.0);
    bool primaryHit = false;
    for (uint bounce = 0u; bounce < maxBounces; ++bounce) {
        RayHit hit = traceClosest(origin, direction, kRayLength);
        if (!hit.hit) {
            radiance += throughput * skyAlong(origin, direction);
            break;
        }
        if (bounce == 0u) {
            primaryHit = true;
            primaryRelative = hit.position - pc.scene.cameraPosition;
        }
        Surface s = hitSurface(hit);
        Lobes l = hitLobes(hit, s);
        vec3 N = s.normal;
        vec3 V = -direction;
        // The shading normal faces the viewer (a normal map can tilt it past).
        if (dot(N, V) < 0.0) {
            N = normalize(N - 1.01 * dot(N, V) * V);
        }
        float NoV = max(dot(N, V), 1e-4);
        vec2 dfg = textureLod(dfgLut, vec2(NoV, sqrt(l.a)), 0.0).xy;
        vec3 energyCompensation = 1.0 + l.f0 * (1.0 / max(dfg.y, 1e-4) - 1.0);
        uint r = 1u + bounce * 4u;

        if (sunOn && pc.scene.sunDirection.y > -0.05) {
            vec2 u = random2(pixel, r);
            vec3 L = sunDiskDirection(pc.scene, u.x, u.y);
            float NoL = dot(N, L);
            vec3 sun = sunAt(hit.position);
            vec3 f = vec3(0.0);
            if (NoL > 0.0) {
                f = l.diffuse / kPi + (l.specular ? specularBrdf(l, N, V, L, energyCompensation)
                                                  : vec3(0.0));
            } else {
                f = l.transmitted / kPi;
            }
            if (any(greaterThan(f, vec3(0.0))) && any(greaterThan(sun, vec3(0.0)))) {
                float visibility = sunRayVisibility(offsetAlong(hit, L), L);
                vec3 contribution = throughput * f * abs(NoL) * sun * visibility;
                if (pc.mode == kReferenceSun) {
                    // The estimate over the closed form E cos / pi (no
                    // visibility), for the disk sampling's normalization.
                    float closed = max(dot(N, pc.scene.sunDirection), 0.0) / kPi;
                    return closed > 0.0 ? contribution / (sun * closed) : vec3(0.0);
                }
                radiance += contribution;
            }
        }
        if (pc.mode == kReferenceSun) {
            break;
        }

        // Continue: one lobe, picked by its albedo.
        const vec3 kLuminance = vec3(0.2126, 0.7152, 0.0722);
        float wd = dot(l.diffuse, kLuminance);
        float wt = dot(l.transmitted, kLuminance);
        float ws = l.specular ? dot(mix(dfg.xxx, dfg.yyy, l.f0) * energyCompensation, kLuminance) : 0.0;
        float total = wd + wt + ws;
        if (total <= 0.0) {
            break;
        }
        vec2 pick = random2(pixel, r + 1u);
        vec2 u = random2(pixel, r + 2u);
        float x = pick.x * total;
        if (x < wd) {
            direction = cosineDirection(N, u);
            throughput *= l.diffuse * (total / wd);
        } else if (x < wd + wt) {
            direction = cosineDirection(-N, u);
            throughput *= l.transmitted * (total / wt);
        } else {
            vec3 H = sampleGgxVisibleNormal(N, V, l.a, u);
            vec3 L = reflect(-V, H);
            float NoL = dot(N, L);
            if (NoL <= 0.0) {
                break;
            }
            vec3 H2 = normalize(V + L);
            vec3 F = fresnelSchlick(l.f0, clamp(dot(L, H2), 0.0, 1.0));
            float G2 = 4.0 * visibilitySmithGgxCorrelated(NoV, NoL, l.a) * NoL * NoV;
            throughput *= F * energyCompensation * (G2 / smithG1(NoV, l.a)) * (total / ws);
            direction = L;
        }
        origin = offsetAlong(hit, direction);

        if (bounce >= 2u) {
            float q = min(max(max(throughput.r, throughput.g), throughput.b), 0.95);
            if (random2(pixel, r + 3u).x >= q) {
                break;
            }
            throughput /= q;
        }
    }
    if (pc.mode == kReferenceRadiance) {
        if (primaryHit) {
            float hazeTransmittance;
            radiance = applyAerialPerspective(radiance, primaryRelative, 1.0, hazeTransmittance);
        }
        return radiance * pc.scene.sunIlluminance * pc.scene.exposure.exposure;
    }
    return radiance;
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= pc.width || pixel.y >= pc.height) {
        return;
    }
    vec2 jitter = random2(pixel, 0u);
    shadingPixel = vec2(pixel) + jitter;
    vec2 ndc = (vec2(pixel) + jitter) / vec2(pc.width, pc.height) * 2.0 - 1.0;
    vec3 direction = normalize(pc.cameraForward + ndc.x * pc.tanHalfFovY * pc.aspect * pc.cameraRight -
                               ndc.y * pc.tanHalfFovY * pc.cameraUp);
    vec3 origin = pc.scene.cameraPosition;

    vec3 value;
    if (pc.mode == kReferenceAlbedo) {
        RayHit hit = traceClosest(origin, direction, kRayLength);
        value = hit.hit ? diffuseAlbedo(hit, hitSurface(hit)) : vec3(0.5);
    } else {
        value = tracePath(origin, direction, pixel);
    }

    uint index = pixel.y * pc.width + pixel.x;
    vec4 sum = pc.sum.pixels[index] + vec4(value, 1.0);
    float luminance = dot(value, vec3(0.2126, 0.7152, 0.0722));
    pc.sum.pixels[index] = sum;
    pc.squares.pixels[index].r += luminance * luminance;
    imageStore(outputImage, ivec2(pixel), vec4(sum.rgb / sum.a, 1.0));
}
