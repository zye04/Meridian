#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "weather.glsl"
#include "clouds.glsl"

// The cloud noise, once at load, every volume tiling (Schneider 2015;
// Hillaire's TileableVolumeNoise). Base 128^3: R Perlin-Worley (Perlin
// dilated by Worley), GBA Worley octaves at 4, 8 and 16 cells per tile.
// Detail 32^3: RGB Worley octaves at 2, 4 and 8 cells. Curl 128^2: the curl
// of 2D Perlin noise (xy, about [-1, 1]), which distorts the detail lookup.
// One invocation per base texel; the first 32^3 also write detail, the
// z = 0 slice the curl.

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image3D baseNoise;
layout(set = 0, binding = 1, rgba8) uniform writeonly image3D detailNoise;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D curlNoise;

float curlPotential(vec2 uv) {
    return gradientOctaves(vec3(uv * 4.0, 0.0), ivec3(4, 4, 1), 3);
}

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID);
    int baseSize = imageSize(baseNoise).x;
    vec3 p = (vec3(id) + 0.5) / float(baseSize);
    float perlin = gradientOctaves(p * 4.0, ivec3(4), 4);
    float worley4 = worleyOctaves(p * 4.0, ivec3(4), 3);
    float perlinWorley = remap(perlin, 0.0, 1.0, worley4, 1.0);
    imageStore(baseNoise, id,
               vec4(perlinWorley, worley4, worleyOctaves(p * 8.0, ivec3(8), 3),
                    worleyOctaves(p * 16.0, ivec3(16), 3)));

    int detailSize = imageSize(detailNoise).x;
    if (all(lessThan(id, ivec3(detailSize)))) {
        vec3 q = (vec3(id) + 0.5) / float(detailSize);
        imageStore(detailNoise, id,
                   vec4(worleyOctaves(q * 2.0, ivec3(2), 3), worleyOctaves(q * 4.0, ivec3(4), 3),
                        worleyOctaves(q * 8.0, ivec3(8), 3), 1.0));
    }

    ivec2 curlSize = imageSize(curlNoise);
    if (id.z == 0 && all(lessThan(id.xy, curlSize))) {
        vec2 uv = (vec2(id.xy) + 0.5) / vec2(curlSize);
        vec2 e = 1.0 / vec2(curlSize);
        float dx = curlPotential(uv + vec2(e.x, 0.0)) - curlPotential(uv - vec2(e.x, 0.0));
        float dy = curlPotential(uv + vec2(0.0, e.y)) - curlPotential(uv - vec2(0.0, e.y));
        // Divergence-free: (d/dy, -d/dx) of the potential, per tile width,
        // scaled to about [-1, 1].
        vec2 curl = vec2(dy / (2.0 * e.y), -dx / (2.0 * e.x)) / 8.0;
        imageStore(curlNoise, id.xy, vec4(clamp(curl, -1.0, 1.0), 0.0, 0.0));
    }
}
