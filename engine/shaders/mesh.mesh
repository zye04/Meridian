#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "farfield.glsl"
#ifdef VISIBILITY
#include "visibility.glsl"
#endif
#define DEBUG_ID_CONSTANTS_ONLY
#include "debug_id.glsl"
#undef DEBUG_ID_CONSTANTS_ONLY

// One workgroup per culled cluster (see cluster_cull.comp): its vertices
// and triangles, with the same outputs as mesh.vert.

layout(local_size_x = 32) in;
layout(triangles, max_vertices = 128, max_primitives = 128) out;

out gl_MeshPerVertexEXT {
    invariant vec4 gl_Position;
} gl_MeshVerticesEXT[];

#ifdef VISIBILITY
// The visibility pass: position, the masked alpha test's inputs, and the
// triangle's id (visibility.glsl) per primitive.
layout(location = 4) out vec2 outUv[];
layout(location = 6) flat out uint outMaterialIndex[];
layout(location = 14) out float outVertexAlpha[];
layout(location = 15) perprimitiveEXT flat out uvec2 outVisibility[];
#else
layout(location = 0) out vec3 outRelativePosition[];
layout(location = 1) out vec3 outNormal[];
layout(location = 2) out vec4 outCurrentClip[];
layout(location = 3) out vec4 outPreviousClip[];
layout(location = 4) out vec2 outUv[];
layout(location = 5) out vec4 outTangent[];
layout(location = 6) flat out uint outMaterialIndex[];
// The cluster's simplification error (m): the shadow rays are traced against
// the full-detail surface, which this one may lie under by up to that much.
layout(location = 7) flat out float outLodError[];
layout(location = 8) out float outHeight[];
layout(location = 9) flat out vec3 outTint[];
layout(location = 10) flat out float outStreamFade[];
// The terrain's sun visibility from the draw list entry (cluster_cull.comp),
// -1 where mesh.frag marches the terrain per fragment.
layout(location = 11) flat out float outTerrainSun[];
layout(location = 12) out float outCrownVisibility[];
// COLOR_0 alpha, for the masked depth prepass's alpha test.
layout(location = 14) out float outVertexAlpha[];
#endif
#ifdef DEBUG_ID
// (instance id, cluster index) for the debug id (debug_id.glsl).
layout(location = 13) flat out uvec2 outDebugId[];
#endif

#include "cluster_vertex.glsl"

void main() {
    // Entries past the list's capacity were dropped by the cull.
    if (gl_WorkGroupID.x >= kMaxDrawnClusters) {
        SetMeshOutputsEXT(0, 0);
        return;
    }
    SceneBuffer scene = pc.scene;
    uvec2 entry = scene.drawLists.entries[pc.drawList * kMaxDrawnClusters +
                                          gl_WorkGroupID.x];
    uint terrainSunCode = entry.x >> 24;
    float terrainSun = terrainSunCode == kTerrainSunPerFragment ? -1.0 : float(terrainSunCode);
    ClusterContext c = loadClusterContext(scene, entry.x & 0xFFFFFFu, entry.y);
#ifdef DEBUG_ID
    // Solo/hide: the cluster goes from every pass this mesh shader feeds.
    if (debugFilterRejects(scene.debugFilter, entry.x, c.mesh.materialIndex)) {
        SetMeshOutputsEXT(0, 0);
        return;
    }
#endif
    SetMeshOutputsEXT(c.cluster.vertexCount, c.cluster.triangleCount);

    for (uint i = gl_LocalInvocationIndex; i < c.cluster.vertexCount; i += 32u) {
        ClusterVertex v = clusterVertex(scene, c, i);
        gl_MeshVerticesEXT[i].gl_Position = v.clip;
#ifdef VISIBILITY
        outUv[i] = v.uv;
        outVertexAlpha[i] = v.alpha;
        outMaterialIndex[i] = c.mesh.materialIndex;
#else
        outRelativePosition[i] = v.relative;
        outNormal[i] = v.normal;
        outTangent[i] = v.tangent;
        outUv[i] = v.uv;
        outVertexAlpha[i] = v.alpha;
        outMaterialIndex[i] = c.mesh.materialIndex;
        outLodError[i] = c.lodError;
        outTint[i] = c.tint;
        outStreamFade[i] = c.instance.fade;
        outTerrainSun[i] = terrainSun;
#ifdef DEBUG_ID
        outDebugId[i] = uvec2(entry.x & 0xFFFFFFu, entry.y);
#endif
        outHeight[i] = v.height;
        outCrownVisibility[i] = v.crownVisibility;
        outCurrentClip[i] = v.currentClip;
        outPreviousClip[i] = v.previousClip;
#endif
    }
    for (uint i = gl_LocalInvocationIndex; i < c.cluster.triangleCount; i += 32u) {
        uint t = scene.clusterTriangles.triangles[c.cluster.firstTriangle + i];
        gl_PrimitiveTriangleIndicesEXT[i] = uvec3(t & 0xFFu, (t >> 8) & 0xFFu, t >> 16);
#ifdef VISIBILITY
        outVisibility[i] = packClusterTriangle(entry.x & 0xFFFFFFu, entry.y, i, terrainSunCode);
#endif
    }
}
