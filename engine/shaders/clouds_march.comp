#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "atmosphere.glsl"
#include "weather.glsl"
#include "clouds.glsl"
#include "clouds_march.glsl"

// Ray-marches the cloud layer at quarter resolution (half inside the layer)
// and writes, per pixel, the pre-exposed in-scattered luminance with the
// haze in front of the clouds (rgb) and the cloud transmittance (a), plus
// the transmittance-weighted mean cloud depth (m along the ray; 0 = no
// cloud), stored as -1 - depth where scene geometry cut the march short
// (in front of or inside the layer). Rays are straight in the
// displayed (curved) frame: the layer is a spherical shell around the
// planet center below the camera, matching the curvature warp, and the
// march stops at the scene's depth.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 2, binding = 0) uniform sampler2D sceneDepth;
layout(set = 2, binding = 1, rgba16f) uniform writeonly image2D cloudColor;
layout(set = 2, binding = 2, r32f) uniform writeonly image2D cloudDepth;

// View march: steps grow with distance (kStepGrowth x t, about the
// footprint of a quarter-res pixel, at least kMinStep); at most kMaxSteps,
// ends at kMaxDistance or when opaque.
const float kMinStep = 60.0;
const float kStepGrowth = 0.012;
const int kMaxSteps = 128;
const float kMaxExposedLuminance = 60000.0;

// Haze between the camera and distance d (m) along the ray: in-scattered
// luminance (sun illuminance 1) and transmittance. Within the aerial
// perspective LUT's range from it (as mesh.frag); beyond, the LUT's last
// value extended with the transmittance LUT and the sky-view luminance.
vec4 haze(vec2 uv, vec3 direction, float d) {
    float distanceKm = d * 0.001;
    float rangeKm = kAerialPerspectiveSlices * kAerialPerspectiveKmPerSlice;
    float slice = min(distanceKm, rangeKm) / kAerialPerspectiveKmPerSlice;
    float weight = 1.0;
    if (slice < 0.5) {
        weight = clamp(slice * 2.0, 0.0, 1.0);
        slice = 0.5;
    }
    vec4 ap = textureLod(aerialPerspectiveLut,
                         vec3(uv, sqrt(slice / kAerialPerspectiveSlices)), 0.0);
    vec3 luminance = ap.rgb * weight;
    float transmittance = mix(1.0, ap.a, weight);
    if (distanceKm > rangeKm) {
        vec3 camera = cloudCameraKm();
        float beyond = transmittanceBetween(camera + direction * rangeKm,
                                            camera + direction * distanceKm, direction);
        vec3 sky = skyLuminance(camera, direction);
        luminance = min(luminance + transmittance * sky * (1.0 - beyond), max(sky, luminance));
        transmittance *= beyond;
    }
    return vec4(luminance, transmittance);
}

void main() {
    ivec2 size = imageSize(cloudColor);
    ivec2 id = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(id, size))) {
        return;
    }
    vec2 uv = (vec2(id) + 0.5) / vec2(size);

    // Unjittered view ray, as the aerial perspective LUT builds it.
    vec4 nearPoint = inverse(pc.scene.currentViewProjection) * vec4(uv * 2.0 - 1.0, 1.0, 1.0);
    vec3 direction = normalize(nearPoint.xyz / nearPoint.w);

    // Scene distance along the ray (reverse-Z, infinite far: depth 0 = sky).
    float sceneDistance = kMaxDistance;
    float depth = textureLod(sceneDepth, uv, 0.0).r;
    if (depth > 0.0) {
        mat4 view = pc.scene.view;
        vec3 forward = -vec3(view[0][2], view[1][2], view[2][2]);
        sceneDistance = pc.scene.nearPlane / depth / max(dot(direction, forward), 1e-4);
    }

    vec2 span = cloudLayerSpan(direction);
    // Scene geometry in front of or inside the layer: no cloud information
    // behind it (flagged for the resolve and composite).
    bool cut = depth > 0.0 && span.y > span.x && sceneDistance < span.y;
    span.y = min(span.y, min(sceneDistance, kMaxDistance));

    CloudMarch march = CloudMarch(vec3(0.0), 1.0, 0.0);
    if (span.y > span.x) {
        // Step boundaries don't depend on the jitter; each sample sits at
        // the same jittered fraction of its own step, so over frames every
        // step is covered evenly. (Jittering only the start shifted later
        // samples less and less where steps split the remaining segment,
        // leaving static bands after accumulation.)
        float jitter = fract(52.9829189 * fract(dot(vec2(id) + 5.588238 * float(pc.scene.frameIndex % 64u),
                                                     vec2(0.06711056, 0.00583715))));
        march = marchClouds(direction, span.x, span.y, jitter, kMinStep, kStepGrowth, kMaxSteps,
                            pc.scene.skyIrradiance.clearIrradiance);
    }
    vec3 luminance = march.luminance;
    float transmittance = march.transmittance;

    float cloudDistance = march.distance;
    if (cloudDistance > 0.0) {
        // The haze in front of the clouds replaces the part of the
        // background's haze they hide: L = L_haze (1 - T) + T_haze L_cloud.
        vec4 front = haze(uv, direction, cloudDistance);
        luminance = front.rgb * (1.0 - transmittance) + front.a * luminance;
    }
    vec3 exposed = luminance * pc.scene.sunIlluminance * pc.scene.exposure.exposure;
    imageStore(cloudColor, id, vec4(min(exposed, vec3(kMaxExposedLuminance)), transmittance));
    imageStore(cloudDepth, id, vec4(cut ? -1.0 - cloudDistance : cloudDistance));
}
