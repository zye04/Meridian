// COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE,
// ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.

layout(local_size_x = 8, local_size_y = 8) in;

// Must match TaaUpscaler (taa_upscaler.cpp): the same set as taa.comp.
layout(set = 0, binding = 1) uniform sampler2D motion;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D history;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outputColor;

// CAS's 0..1 (peak lobe -1/8 to -1/5), applied in proportion to the
// pixel's motion: a still image is left alone (sharpening a still frame
// only amplifies its frame-to-frame noise, decisions.md TAA v2), while a
// moving one gets back what the history's resampling blurred.
const float kSharpness = 0.0;
// Motion (render pixels per frame) that gets the full strength, and that
// strength as a fraction of CAS's weakest lobe.
const float kMotionPixels = 0.5;
const float kMotionStrength = 0.25;

ivec2 size;

// CAS wants its input within [0, 1], with 1 the display's peak; the colour
// here is HDR (pre-exposed, so ~1 is bright but highlights go far above).
// A reversible tonemap maps it there and back (Karis 2014).
vec3 load(ivec2 p) {
    vec3 c = imageLoad(history, clamp(p, ivec2(0), size - 1)).rgb;
    return c / (1.0 + max(c.r, max(c.g, c.b)));
}

vec3 unload(vec3 c) {
    return min(c / (1.0 - max(c.r, max(c.g, c.b))), vec3(65504.0));
}

void main() {
    size = imageSize(outputColor);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    ivec2 renderSize = textureSize(motion, 0);
    ivec2 texel = ivec2((vec2(pixel) + 0.5) * vec2(renderSize) / vec2(size));
    float moving = length(texelFetch(motion, texel, 0).xy * vec2(renderSize));
    float strength = kMotionStrength * clamp(moving / kMotionPixels, 0.0, 1.0);
    if (strength == 0.0) {
        imageStore(outputColor, pixel, imageLoad(history, pixel));
        return;
    }

    // a b c
    // d e f
    // g h i
    vec3 a = load(pixel + ivec2(-1, -1));
    vec3 b = load(pixel + ivec2(0, -1));
    vec3 c = load(pixel + ivec2(1, -1));
    vec3 d = load(pixel + ivec2(-1, 0));
    vec3 e = load(pixel);
    vec3 f = load(pixel + ivec2(1, 0));
    vec3 g = load(pixel + ivec2(-1, 1));
    vec3 h = load(pixel + ivec2(0, 1));
    vec3 i = load(pixel + ivec2(1, 1));

    // Soft min and max: the cross plus the full 3x3, so 2x too big.
    vec3 mn = min(min(min(d, e), min(f, b)), h);
    mn += min(min(min(mn, a), min(c, g)), i);
    vec3 mx = max(max(max(d, e), max(f, b)), h);
    mx += max(max(max(mx, a), max(c, g)), i);

    // Sharpen less where the neighbourhood is already near a signal limit.
    vec3 amp = sqrt(clamp(min(mn, 2.0 - mx) / max(mx, vec3(1e-6)), 0.0, 1.0));
    float peak = -1.0 / mix(8.0, 5.0, kSharpness);
    // Green's weight for all channels, as CAS does by default.
    float w = amp.g * peak * strength;
    vec3 result = clamp((b * w + d * w + f * w + h * w + e) / (1.0 + 4.0 * w), 0.0, 1.0);
    // Keep the result strictly below 1, where the inverse tonemap is finite.
    result = min(result, vec3(1.0 - 1.0 / 65536.0));
    imageStore(outputColor, pixel, vec4(unload(result), 1.0));
}
