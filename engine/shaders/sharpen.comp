#version 460

// Contrast-adaptive sharpening of the TAA resolve into the upscaler's
// output; the history itself stays unsharpened, so this never feeds back.
//
// Ported from AMD FidelityFX CAS 1.20190610, sharpen-only path with
// CAS_BETTER_DIAGONALS and exact math (CAS_GO_SLOWER):
// https://github.com/GPUOpen-Effects/FidelityFX-CAS, ffx-cas/ffx_cas.h at
// commit 9fabcc9a2c45f958aff55ddfda337e74ef894b7f.
//
