#version 460
#extension GL_GOOGLE_include_directive : require
#include "post.glsl"

// Turns the luminance histogram into a new exposure. Averages the middle of
// the histogram (ignoring the darkest and brightest 10%, so the sun or deep
// shadows don't swing it), converts to EV100 (Lagarde & de Rousiers 2014),
// and eases toward it like an eye adapting. Also clears the histogram.
// 256 bins are trivial work, so one thread does it all.

layout(local_size_x = 1) in;

const float kLowPercentile = 0.1;
const float kHighPercentile = 0.9;
const float kMinEv100 = -6.0;
const float kMaxEv100 = 18.0;
const float kAdaptationSpeed = 1.5;
// K = 12.5 and the 1.2 saturation factor put the mean log luminance at
// 0.104 of the white point, 0.8 EV under 18% grey: photos and games read
// as underexposed there, so the target is raised to put the mean at grey.
const float kMeanToGreyEv = 0.8;
// Highlights: the exposure never puts the 95th percentile above this
// (pre-exposed; AgX reaches white at ~3), so dark-foliage views don't blow
// out the sky behind them. The Chlorophyll frames keep cloud tops at OKLCh
// L ~0.87.
const float kHighlightPercentile = 0.95;
const float kHighlightMax = 2.0;
// Shade: the exposure never rises more than this above the one an open,
// sunlit landscape would meter at the camera's light
// (SkyIrradianceBuffer.openIlluminance). Mean-to-grey metering alone lifts
// a forest interior back to mid-grey; real canopy shade is 1.5-5% of open
// light (G7, research/2026-11-23-G7-grey-image.md). The reflectance is a
// vegetated landscape's: with it the open start view's own meter (EV100
// 13.56) and this model (13.39) agree. The bound holds on the displayed
// image: the grade's exposure (applied in the LUT, after the meter) moves it
// by as much the other way, so a grade that darkens open views (a negative
// grade EV) leaves shade held at the bound as bright as without it. As a
// compensation that depends on the metered level (Unreal's exposure
// compensation curve): full where the meter sits above the bound, fading
// to none where the bound holds.
const float kOpenReflectance = 0.09;
const float kMaxShadeLiftEv = 3.0;

void main() {
    uint total = 0u;
    for (uint i = 0u; i < kHistogramBins; ++i) {
        total += post.histogram.bins[i];
    }

    float low = float(total) * kLowPercentile;
    float high = float(total) * kHighPercentile;
    float cumulative = 0.0;
    float logSum = 0.0;
    float weightSum = 0.0;
    float highlight = float(total) * kHighlightPercentile;
    float highlightLog = kMinLogLuminance;
    for (uint i = 0u; i < kHistogramBins; ++i) {
        float count = float(post.histogram.bins[i]);
        post.histogram.bins[i] = 0u;

        float inRange = max(min(cumulative + count, high) - max(cumulative, low), 0.0);
        float logLuminance = kMinLogLuminance +
            (float(i) + 0.5) / float(kHistogramBins) * kLogLuminanceRange;
        if (cumulative < highlight) {
            highlightLog = logLuminance;
        }
        cumulative += count;
        logSum += inRange * logLuminance;
        weightSum += inRange;
    }

    post.exposure.previousExposure = post.exposure.exposure;
    float current = post.exposure.ev100;
    float target = current;
    if (weightSum > 0.0) {
        // EV100 = log2(L * S / K) with ISO S = 100 and calibration K = 12.5.
        target = logSum / weightSum + log2(100.0 / 12.5) -
                 kMeanToGreyEv;
        // exposure = 1 / (1.2 * 2^EV100), so L * exposure <= max.
        float openLuminance = kOpenReflectance / 3.14159265 * post.skyIrradiance.openIlluminance;
        float openEv = log2(max(openLuminance, 1e-6) * 100.0 / 12.5) - kMeanToGreyEv;
        target = max(target, highlightLog - log2(1.2 * kHighlightMax));
        target = max(target, openEv - kMaxShadeLiftEv + post.gradeExposureEv) - post.exposureCompensation;
        target = clamp(target, kMinEv100, kMaxEv100);
    }

    float ev100 = current + (target - current) *
                  (1.0 - exp(-post.deltaSeconds * kAdaptationSpeed));
    post.exposure.ev100 = ev100;
    // The luminance that saturates a sensor at this EV maps to 1.0.
    post.exposure.exposure = 1.0 / (1.2 * exp2(ev100));
}
