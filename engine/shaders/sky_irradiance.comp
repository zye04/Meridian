#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "atmosphere.glsl"
#include "weather.glsl"
#include "clouds.glsl"

// Integrates the sky over the upper hemisphere (cosine-weighted) to get its
// irradiance on an upward-facing surface: the sky-view LUT with the sky
// capture's clouds over it (ambient light for the scene), and the LUT alone
// (the clear sky lighting the clouds). 256 directions, one per thread.

layout(local_size_x = 256) in;

shared vec3 partial[256];
shared vec3 partialClear[256];

void main() {
    uint index = gl_LocalInvocationIndex;
    vec3 camera = atmospherePosition(pc.scene.cameraPosition);
    float viewHeight = length(camera);
    vec3 up = camera / viewHeight;

    // Fibonacci spiral: even coverage of the hemisphere.
    float t = (float(index) + 0.5) / 256.0;
    float cosTheta = sqrt(1.0 - t);
    float sinTheta = sqrt(t);
    float phi = float(index) * 2.39996323;
    vec3 local = vec3(sinTheta * cos(phi), cosTheta, sinTheta * sin(phi));

    vec3 tangent = normalize(cross(abs(up.y) < 0.99 ? vec3(0, 1, 0) : vec3(1, 0, 0), up));
    vec3 bitangent = cross(up, tangent);
    vec3 direction = local.x * tangent + local.y * up + local.z * bitangent;

    vec3 side = normalize(cross(up, direction));
    vec3 forward = normalize(cross(side, up));
    vec2 lightOnPlane = normalize(vec2(dot(pc.scene.sunDirection, forward),
                                       dot(pc.scene.sunDirection, side)) + 1e-6);
    bool intersectsGround = raySphereIntersectNearest(
        camera, direction, pc.scene.atmosphere.bottomRadius) >= 0.0;
    vec2 uv = skyViewLutUv(intersectsGround, dot(direction, up), lightOnPlane.x, viewHeight);

    // Cosine-weighted samples: irradiance = pi * mean(luminance).
    vec3 sky = textureLod(skyViewLut, uv, 0.0).rgb;
    vec4 clouds = skyCaptureAt(direction);
    partial[index] = sky * clouds.a + clouds.rgb;
    partialClear[index] = sky;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (index < stride) {
            partial[index] += partial[index + stride];
            partialClear[index] += partialClear[index + stride];
        }
        barrier();
    }
    if (index == 0u) {
        pc.scene.skyIrradiance.irradiance = kPi * partial[0] / 256.0;
        pc.scene.skyIrradiance.clearIrradiance = kPi * partialClear[0] / 256.0;
    }
}
