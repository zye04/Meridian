#version 460
#extension GL_GOOGLE_include_directive : require
#define MERIDIAN_CUSTOM_PUSH_CONSTANTS
#include "common.glsl"
#include "cull.glsl"
#include "terrain.glsl"
#include "voxel_lod.glsl"

// One workgroup per voxel cluster cluster_cull.comp listed in this phase:
// its voxels that draw are listed for voxel_instance.mesh (cluster entry |
// terrain sun << 31, pool brick << 6 | voxel), 64 per workgroup, one
// reservation per 64 bricks. Bricks outside the frustum are skipped. A
// voxel of opacity f along the view (coverage) draws, unless the model
// hides it from the camera (kVoxelHiddenDepth), by the main view's rule
// (voxel_lod.glsl): a leaf voxel's shrunk quad on its share of the jitter
// phases; a whole quad (wood, cascades, the hash A/B) where a stable hash of
// instance, brick and voxel is below f (stable, so a still view never boils;
// keyed on the brick's lattice place, edge and the cluster's seed, not its
// pool index) or, of an opaque part, f reaches kOpaqueVoxelFloor. The
// terrain's sun visibility is marched once from the cluster's centre (as
// cluster_cull.comp does per small cluster; a voxel cluster spans one
// region). Foliage bricks are sparse (about one drawn voxel each at the
// forest overview): listing bricks first cost more than the voxels. The
// cluster passed the cluster cull's frustum and occlusion tests.

layout(local_size_x = 64) in;

shared uint keptCount;
shared uint keptFirst;
shared uint keptPool[64];
shared VoxelBrick keptBrick[64];
shared uint quadCount;
shared uint threadQuads[64];
shared uint quadFirst;
shared uint areaSum;
shared uint subpixelSum;

// Whether the terrain lets the sun reach a point (world), one ray toward a
// point of the sun's disk fixed per brick.
uint terrainSun(vec3 world, uint pool, uint id) {
    vec3 sun = cull.scene.sunDirection;
    if (sun.y < -sin(cull.scene.sunAngularRadius)) {
        return 0u;
    }
    vec3 origin = world;
    origin.y = max(origin.y, terrainHeight(cull.scene.terrain, origin.xz) + kShadowRayBias);
    uvec3 h = pcg3d(uvec3(id, pool, 1u));
    vec3 direction = sunDiskDirection(cull.scene, float(h.x >> 8u) * (1.0 / 16777216.0),
                                      float(h.y >> 8u) * (1.0 / 16777216.0));
    float visibility = terrainShadowVisibility(cull.scene, origin);
    if (visibility >= 0.0) {
        return visibility > float(h.z >> 8u) * (1.0 / 16777216.0) ? 1u : 0u;
    }
    return terrainOccludes(cull.scene, origin, direction, kShadowRayLength) ? 0u : 1u;
}

// Reserves `count` consecutive entries of a list (counters[counter]); what
// doesn't fit is given back and counted as dropped. Returns what fits.
uint reserve(uint counter, uint capacity, uint count, out uint first) {
    first = atomicAdd(cull.counters.counters[counter], count);
    uint end = min(first + count, capacity);
    uint kept = end > first ? end - first : 0u;
    if (kept < count) {
        atomicAdd(cull.counters.counters[counter], kept - count);
        atomicAdd(cull.counters.counters[kCounterVoxelDrops], count - kept);
        atomicAdd(cull.counters.counters[kCounterOverflow], count - kept);
    }
    return kept;
}

void main() {
    SceneBuffer scene = cull.scene;
    uint phase = cull.phase & 1u;
    uint clusterEntry = phase * kMaxVoxelInstances + gl_WorkGroupID.x;
    uvec2 entry = scene.voxelInstances.entries[clusterEntry];
    LoadedInstance instance = loadInstance(scene, entry.x);
    ClusterInfo cluster = scene.clusters.clusters[entry.y];
    VoxelPoolBuffer pools = scene.voxelPools;
    float v = cluster.voxelEdge;
    float radius = 0.8660254 * 4.0 * v * instance.scale;
    mat3 toLocal = transpose(mat3(instance.transform));
    uint list = phase * 2u;
    uint quadBase = voxelQuadListStart(list);
    uint i = gl_LocalInvocationIndex;
    if (i == 0u) {
        vec3 world = (instance.transform * vec4(cluster.boundsCenter, 1.0)).xyz;
        // A cascade needs no lighting, only where the voxels block the sun.
        keptFirst = scene.shadowView != 0u ? 1u : terrainSun(world, entry.y, entry.x);
        areaSum = 0u;
        subpixelSum = 0u;
    }
    barrier();
    uint sun = keptFirst << 31;

    for (uint base = 0u; base < cluster.triangleCount; base += 64u) {
        if (i == 0u) {
            keptCount = 0u;
        }
        barrier();
        if (base + i < cluster.triangleCount) {
            uint pool = cluster.firstTriangle + base + i;
            VoxelBrick brick = pools.bricks.bricks[pool];
            vec3 local = (vec3(brick.originX, brick.originY, brick.originZ) + 2.0) * v;
            vec3 relative = (instance.transform * vec4(local, 1.0)).xyz - scene.cameraPosition;
            vec4 sphere = displayedSphere(relative, radius);
            if (inFrustum(sphere.xyz, sphere.w)) {
                uint k = atomicAdd(keptCount, 1u);
                keptPool[k] = pool;
                keptBrick[k] = brick;
            }
        }
        barrier();
        if (i == 0u) {
            atomicAdd(cull.counters.counters[kCounterVoxelBricks + phase], keptCount);
        }

        // The kept bricks' voxels: thread i decides voxel i of every kept
        // brick (a bit per brick), then one reservation for the batch.
        uint kept = keptCount;
        uvec2 drawnMask = uvec2(0u);
        uint area = 0u, subpixel = 0u;
        for (uint k = 0u; k < kept; ++k) {
            VoxelBrick brick = keptBrick[k];
            if (!voxelPresent(brick, i)) {
                continue;
            }
            uint slot = voxelSlot(brick, i);
            vec3 local = (vec3(voxelCoords(brick, i)) + 0.5) * v;
            vec3 relative = (instance.transform * vec4(local, 1.0)).xyz - scene.cameraPosition;
            // A cascade looks along the sun (orthographic).
            vec3 view = normalize(toLocal * (scene.shadowView != 0u ? -scene.sunDirection : relative));
            // The cheapest test first (one word); the hash and the quad's size
            // only for the voxels it keeps.
            if (!(voxelBoxDepth(pools.axis.words[slot], -view) < kVoxelHiddenDepth)) {
                continue;
            }
            uvec4 packedVoxel = pools.voxels.voxels[slot];
            float opacity = voxelViewOpacity(voxelDepths(packedVoxel), view);
            uvec3 hash = voxelHash(entry.x, brick, v, cluster.firstVertex, i);
            bool whole = voxelDrawsWhole(scene.voxelCoverage, scene.shadowView != 0u, packedVoxel);
            // voxel_instance.mesh's full quad, in pixels.
            float pixels = 0.0;
            if (whole) {
                if (!voxelDraws(packedVoxel, opacity, voxelUnit(hash.x))) {
                    continue;
                }
                pixels = voxelQuadPixels(scene, relative, view, v * instance.scale);
            } else {
                pixels = voxelQuadPixels(scene, relative, view, v * instance.scale);
                if (!voxelShrunkDraws(scene.voxelCoverage, opacity, pixels, hash.z, voxelUnit(hash.x))) {
                    continue;
                }
                pixels *= voxelAreaFraction(opacity, pixels);
            }
            drawnMask[k >> 5] |= 1u << (k & 31u);
            area += uint(min(pixels, 65536.0) * 16.0 + 0.5);
            subpixel += pixels < 1.0 ? 1u : 0u;
        }
        atomicAdd(areaSum, area);
        atomicAdd(subpixelSum, subpixel);
        threadQuads[i] = bitCount(drawnMask.x) + bitCount(drawnMask.y);
        barrier();
        if (i == 0u) {
            uint total = 0u;
            for (uint t = 0u; t < 64u; ++t) {
                uint n = threadQuads[t];
                threadQuads[t] = total;
                total += n;
            }
            quadCount = 0u;
            if (total > 0u) {
                quadCount = reserve(kCounterVoxelQuads + list, kMaxVoxelQuads, total, quadFirst);
                uint end = quadFirst + quadCount;
                atomicMax(cull.counters.counters[kCounterVoxelTasks + list * 3u], (end + 63u) / 64u);
            }
        }
        barrier();
        uint slot = threadQuads[i];
        for (uint w = 0u; w < 2u; ++w) {
            while (drawnMask[w] != 0u && slot < quadCount) {
                uint k = w * 32u + uint(findLSB(drawnMask[w]));
                drawnMask[w] &= drawnMask[w] - 1u;
                scene.voxelInstances.entries[quadBase + quadFirst + slot++] =
                    uvec2(clusterEntry | sun, keptPool[k] << 6 | i);
            }
        }
        barrier();
    }
    if (i == 0u) {
        atomicAdd(cull.counters.counters[kCounterVoxelArea], areaSum);
        atomicAdd(cull.counters.counters[kCounterVoxelSubpixel], subpixelSum);
    }
}
