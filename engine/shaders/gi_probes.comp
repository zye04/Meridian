#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "atmosphere.glsl"
#include "terrain.glsl"
#include "weather.glsl"
#include "clouds.glsl"
#include "farfield.glsl"
#include "gi.glsl"

// Traces the GI probes (gi.glsl): one workgroup per probe, one ray per
// thread over a spherical Fibonacci set rotated every frame. Rays march the
// heightfield (and the far-field trees' voxels); a hit returns the ground
// cache's radiance (lit directly where it holds none), a miss the sky with
// the sky capture's clouds. The radiance is
// projected on L1 SH and blended into the probe's history. A frame updates
// every 8th probe of the finest level, every 16th of the next and every
// 32nd of the coarser ones, plus any probe whose slot holds another column (it
// scrolled in) or that was never traced.

layout(local_size_x = 64) in;

const uint kRays = 64u;
const float kHysteresis = 0.95;

shared vec3 partial[4][kRays];
shared bool traced;
shared vec3 probePosition;
shared float probeBase;
shared bool fresh;
shared float canopySun;
shared vec3 sunAtProbe;

// A rotation that changes every frame (deterministic), from a hashed axis
// and angle.
mat3 frameRotation(uint frame) {
    uvec3 h = pcg3d(uvec3(frame, 0x9e37u, 0x79b9u));
    vec3 r = vec3(h) * (1.0 / 4294967296.0);
    float z = r.x * 2.0 - 1.0;
    float phi = r.y * 2.0 * kPi;
    vec3 axis = vec3(sqrt(1.0 - z * z) * cos(phi), z, sqrt(1.0 - z * z) * sin(phi));
    float angle = r.z * 2.0 * kPi;
    float c = cos(angle), s = sin(angle);
    mat3 k = mat3(0.0, axis.z, -axis.y, -axis.z, 0.0, axis.x, axis.y, -axis.x, 0.0);
    return mat3(1.0) + s * k + (1.0 - c) * (k * k);
}

void main() {
    GiBuffer gi = pc.scene.gi;
    uint probe = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    uint perLevel = uint(kGiColumns * kGiColumns) * kGiSlices;
    if (probe >= perLevel * kGiLevels) {
        return;
    }
    uint k = probe / perLevel;
    uint local = probe % perLevel;
    uint slice = local % kGiSlices;
    ivec2 slot = ivec2((local / kGiSlices) % uint(kGiColumns), local / (kGiSlices * uint(kGiColumns)));
    GiLevel level = gi.levels[k];
    // The column of the window that maps to this slot.
    ivec2 column = level.origin + ivec2(giWrap(slot.x - level.origin.x), giWrap(slot.y - level.origin.y));
    Terrain terrain = pc.scene.terrain;
    FarFieldBuffer farField = pc.scene.farField;

    if (gl_LocalInvocationIndex == 0u) {
        GiProbe stored = gi.probes[probe];
        fresh = gi.reset != 0u || stored.valid == 0.0 || stored.column != column;
        // Spread over columns and slices, so no height level updates as one;
        // coarser levels (farther, slower to change on screen) less often.
        uint period = 8u << min(k, 2u);
        traced = fresh || (uint(column.x + 3 * column.y + 5 * int(slice)) & (period - 1u)) ==
                              (gi.frame & (period - 1u));
        if (traced) {
            // The base is the terrain under the probe (not the column's
            // maximum, which would float coarse levels' bottom probes far
            // above receivers on slopes).
            vec2 centre = (vec2(column) + 0.5) * level.spacing;
            float base = fresh ? (terrain.width > 0u ? terrainHeight(terrain, centre) : 0.0) + 0.05
                               : stored.base;
            probeBase = base;
            probePosition = vec3(centre.x, base + giSliceHeight(level, float(slice)), centre.y);
            canopySun = 1.0;
            if (pc.scene.farFieldEnabled != 0u && pc.scene.sunDirection.y > 0.0) {
                canopySun = farFieldTransmittance(farField, probePosition,
                                                  pc.scene.sunDirection, 0.0, kGiTreeDistance, false);
            }
            vec3 atmosphere = atmospherePosition(probePosition);
            float height = length(atmosphere);
            sunAtProbe = transmittanceToSun(height, dot(atmosphere / height, pc.scene.sunDirection)) *
                         cloudShadow(probePosition);
        }
    }
    barrier();
    if (!traced) {
        return;
    }

    uint i = gl_LocalInvocationIndex;
    // Spherical Fibonacci directions, rotated per frame.
    float z = 1.0 - (2.0 * float(i) + 1.0) / float(kRays);
    float phi = float(i) * 2.39996323;
    float r = sqrt(max(1.0 - z * z, 0.0));
    vec3 direction = frameRotation(gi.frame) * vec3(r * cos(phi), z, r * sin(phi));

    vec3 origin = probePosition;
    vec3 sun = pc.scene.sunDirection;
    vec3 skyIrradiance = pc.scene.skyIrradiance.irradiance;
    float hit = terrain.width > 0u ? terrainRayDistance(pc.scene, origin, direction, kGiMaxDistance)
                                   : -1.0;
    vec3 radiance;
    if (hit >= 0.0) {
        vec3 p = origin + hit * direction;
        vec4 cached = giGroundRadiance(p.xz);
        radiance = cached.rgb * cached.a;
        if (cached.a < 1.0) {
            vec3 n = terrainNormalAt(terrain, p.xz);
            vec3 atmosphere = atmospherePosition(p);
            float height = length(atmosphere);
            vec3 sunAtSurface = transmittanceToSun(height, dot(atmosphere / height, sun));
            float lit = max(dot(n, sun), 0.0) * giGroundSunVisibility(p, n);
            radiance += (1.0 - cached.a) * kGiGroundAlbedo / kPi * (sunAtSurface * lit + skyIrradiance);
        }
    } else {
        vec4 clouds = skyCaptureAt(direction);
        radiance = skyLuminance(atmospherePosition(origin), direction) * clouds.a + clouds.rgb;
    }
    if (pc.scene.farFieldEnabled != 0u) {
        vec3 foliageAlbedo;
        float transmittance = farFieldTransmittanceAlbedo(
            farField, origin, direction, 0.0,
            hit >= 0.0 ? min(hit, kGiTreeDistance) : kGiTreeDistance, foliageAlbedo);
        // Leaves above the probe are sunlit more often than the probe is:
        // about half of a crown's leaves see the sun.
        float leafSun = mix(canopySun, 0.5, max(direction.y, 0.0));
        vec3 leaf = foliageAlbedo / kPi * (sunAtProbe * (0.5 * leafSun * max(sun.y, 0.0)) +
                                         0.5 * skyIrradiance);
        radiance = mix(leaf, radiance, transmittance);
    }

    // L1 projection: 4 pi / kRays per sample, reduced in shared memory.
    float weight = 4.0 * kPi / float(kRays);
    partial[0][i] = radiance * (kY00 * weight);
    partial[1][i] = radiance * (kY1 * direction.y * weight);
    partial[2][i] = radiance * (kY1 * direction.z * weight);
    partial[3][i] = radiance * (kY1 * direction.x * weight);
    barrier();
    for (uint stride = kRays / 2u; stride > 0u; stride >>= 1u) {
        if (i < stride) {
            for (int c = 0; c < 4; ++c) {
                partial[c][i] += partial[c][i + stride];
            }
        }
        barrier();
    }
    if (i == 0u) {
        float history = fresh ? 0.0 : kHysteresis;
        GiProbe stored = gi.probes[probe];
        for (int ch = 0; ch < 3; ++ch) {
            vec4 traced4 = vec4(partial[0][0][ch], partial[1][0][ch], partial[2][0][ch],
                                partial[3][0][ch]);
            vec4 sh = mix(traced4, stored.sh[ch], history);
            gi.probes[probe].sh[ch] = sh;
            // Half floats: keep a stray huge value from becoming inf.
            vec4 packed = clamp(sh, vec4(-60000.0), vec4(60000.0));
            gi.volumeBuffer.texels[probe * 3u + uint(ch)] =
                uvec2(packHalf2x16(packed.xy), packHalf2x16(packed.zw));
        }
        gi.probes[probe].column = column;
        gi.probes[probe].base = probeBase;
        gi.probes[probe].valid = 1.0;
    }
}
