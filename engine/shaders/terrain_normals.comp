#version 460
#extension GL_GOOGLE_include_directive : require
#define MERIDIAN_CUSTOM_PUSH_CONSTANTS
#include "common.glsl"
#include "terrain.glsl"

// The terrain normal map's full-resolution level, once at load: per sample,
// the normal from central differences of its mirrored neighbors (the
// gradient of the bilinear surface, averaged over two cells). Stores x and
// z; y is positive and reconstructed when sampled. Mips are blitted from
// this level.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rg16_snorm) uniform writeonly image2D normals;

// Must match TerrainNormalConstants in C++.
layout(push_constant) uniform NormalConstants {
    uint heightTexture;
    uint width;
    uint height;
    float spacing;
    float heightScale;
} constants;

void main() {
    ivec2 size = ivec2(constants.width, constants.height);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, size))) {
        return;
    }
    uint t = constants.heightTexture;
    vec2 slope = vec2(terrainRawSample(t, size, p.x + 1, p.y) -
                          terrainRawSample(t, size, p.x - 1, p.y),
                      terrainRawSample(t, size, p.x, p.y + 1) -
                          terrainRawSample(t, size, p.x, p.y - 1)) *
                 (constants.heightScale / (2.0 * constants.spacing));
    vec3 n = normalize(vec3(-slope.x, 1.0, -slope.y));
    imageStore(normals, p, vec4(n.xz, 0.0, 0.0));
}
