#version 460
#extension GL_GOOGLE_include_directive : require
#define MERIDIAN_CUSTOM_PUSH_CONSTANTS
#include "common.glsl"
#include "clouds_temporal.glsl"

// Composites the resolved clouds over the HDR target at full resolution
// (premultiplied: clouds + background x transmittance) and, where clouds
// dominate the pixel, writes their motion, and raises the transparency mask
// to the cloud coverage. Reads scene depth; writes HDR color, motion and
// the mask. The upsample is bilateral on scene depth: each
// low-resolution texel counts only where it agrees with this pixel's
// surface, so silhouettes in front of clouds stay sharp and clouds never
// bleed onto them.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 2, binding = 0) uniform sampler2D sceneDepth;
layout(set = 2, binding = 5, rgba16f) uniform readonly image2D resolvedColor;
layout(set = 2, binding = 6, r32f) uniform readonly image2D resolvedDepth;
layout(set = 2, binding = 7, rgba16f) uniform image2D hdr;
layout(set = 2, binding = 8, rg16f) uniform writeonly image2D motion;
layout(set = 2, binding = 10, r8) uniform image2D transparencyMask;

// Cloud opacity above which the motion target gets the clouds' motion.
const float kMotionOpacity = 0.5;
const float kSky = 1e30;

vec4 cloudSum;
float weightSum;
float depthSum;
float depthWeight;
// A tap disagreed with this pixel's surface (skipped or read as clear).
bool disagreed;

// Adds a low-resolution texel as seen from this pixel's surface (distance
// along the ray; kSky for none): a texel whose march geometry cut short
// (stored -1 - depth) says nothing about the sky here, and clouds behind
// the surface are hidden.
void accumulate(ivec2 texel, float weight, float sceneDistance) {
    vec4 cloud = imageLoad(resolvedColor, texel);
    float d = imageLoad(resolvedDepth, texel).r;
    if (d < 0.0) {
        disagreed = true;
        if (sceneDistance == kSky) {
            return;
        }
        d = -1.0 - d;
    }
    if (d > sceneDistance) {
        disagreed = true;
        cloud = vec4(0.0, 0.0, 0.0, 1.0);
    }
    cloudSum += cloud * weight;
    weightSum += weight;
    float opacity = (1.0 - cloud.a) * max(weight, 0.0);
    if (d > 0.0 && opacity > 0.0) {
        depthSum += d * opacity;
        depthWeight += opacity;
    }
}

void main() {
    ivec2 size = imageSize(hdr);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(size);

    // The surface's distance along this pixel's ray, from reverse-Z.
    float sceneDistance = kSky;
    float depth = texelFetch(sceneDepth, pixel, 0).r;
    if (depth > 0.0) {
        vec2 ndc = (uv * 2.0 - 1.0) / pc.scene.projectionScale;
        sceneDistance = pc.scene.nearPlane / depth * sqrt(1.0 + dot(ndc, ndc));
    }

    ivec2 lowSize = imageSize(resolvedColor);
    vec2 p = uv * vec2(lowSize) - 0.5;
    ivec2 base = ivec2(floor(p));
    vec2 f = p - vec2(base);
    // Catmull-Rom over 4x4 texels where every tap agrees with this pixel's
    // surface: bilinear's slope breaks at texel centers showed as a static
    // 4-px grid. Elsewhere (silhouettes) the bilateral bilinear taps, which
    // can't ring across the edge.
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    float wx[4] = float[4](w0.x, w1.x, w2.x, w3.x);
    float wy[4] = float[4](w0.y, w1.y, w2.y, w3.y);
    cloudSum = vec4(0.0);
    weightSum = 0.0;
    depthSum = 0.0;
    depthWeight = 0.0;
    disagreed = false;
    // Catmull-Rom's negative lobes overshoot at sharp edges (a lit cloud
    // top over a dark underside): per channel below zero, then clamped,
    // that left saturated blue texels. Clamping to the central 2x2 range
    // keeps the result between its neighbors.
    vec4 lowest = vec4(1e30);
    vec4 highest = vec4(-1e30);
    // The outline's wider blur: a tent of radius 2 texels around this
    // pixel, continuous across texel borders like the Catmull-Rom.
    vec4 wide = vec4(0.0);
    float wideWeight = 0.0;
    for (int y = 0; y < 4; ++y) {
        for (int x = 0; x < 4; ++x) {
            ivec2 texel = clamp(base + ivec2(x - 1, y - 1), ivec2(0), lowSize - 1);
            accumulate(texel, wx[x] * wy[y], sceneDistance);
            vec4 c = imageLoad(resolvedColor, texel);
            vec2 tent = max(2.0 - abs(vec2(x - 1, y - 1) - f), 0.0);
            wide += c * tent.x * tent.y;
            wideWeight += tent.x * tent.y;
            if (x >= 1 && x <= 2 && y >= 1 && y <= 2) {
                lowest = min(lowest, c);
                highest = max(highest, c);
            }
        }
    }
    bool ringClamp = !disagreed;
    if (disagreed) {
        cloudSum = vec4(0.0);
        weightSum = 0.0;
        depthSum = 0.0;
        depthWeight = 0.0;
        for (int y = 0; y <= 1; ++y) {
            for (int x = 0; x <= 1; ++x) {
                float w = (x == 0 ? 1.0 - f.x : f.x) * (y == 0 ? 1.0 - f.y : f.y);
                accumulate(clamp(base + ivec2(x, y), ivec2(0), lowSize - 1), w, sceneDistance);
            }
        }
    }
    // Sky in a gap the bilinear footprint saw only as geometry (thin gaps
    // between silhouettes): the nearest ring of texels that saw the sky.
    if (weightSum < 1e-3) {
        cloudSum = vec4(0.0);
        weightSum = 0.0;
        depthSum = 0.0;
        depthWeight = 0.0;
        for (int y = -1; y <= 2; ++y) {
            for (int x = -1; x <= 2; ++x) {
                accumulate(clamp(base + ivec2(x, y), ivec2(0), lowSize - 1), 1.0, sceneDistance);
            }
        }
    }
    if (weightSum <= 0.0) {
        return;
    }
    vec4 cloud = cloudSum / weightSum;
    if (ringClamp) {
        cloud = clamp(cloud, lowest, highest);
        // Outline: unsharp mask of the resolved clouds against the wider
        // blur. The opacity hardens the outer silhouette; the luminance per
        // unit opacity (the cloud's own shading) raises the steps between
        // lit and shaded lobes inside it. Applied as scales of the
        // premultiplied colour, so the hue holds (sharpening the channels
        // apart left dark blue rims) and nothing goes negative; no range
        // clamp, which showed the texel grid as flat blocks.
        float opacity = 1.0 - cloud.a;
        if (pc.outline > 0.0 && opacity > 1e-4) {
            wide /= wideWeight;
            float wideOpacity = 1.0 - wide.a;
            float sharpOpacity = clamp(opacity + pc.outline * (opacity - wideOpacity), 0.0, 1.0);
            const vec3 kLuma = vec3(0.2126, 0.7152, 0.0722);
            float shade = dot(cloud.rgb, kLuma) / opacity;
            float wideShade = dot(wide.rgb, kLuma) / max(wideOpacity, 1e-4);
            float contrast = clamp(1.0 + pc.outline * opacity * (shade - wideShade) /
                                             max(wideShade, 1e-6),
                                   0.5, 2.0);
            cloud = vec4(cloud.rgb * (sharpOpacity / opacity) * contrast, 1.0 - sharpOpacity);
        }
    }
    cloud = vec4(max(cloud.rgb, 0.0), clamp(cloud.a, 0.0, 1.0));
    vec4 background = imageLoad(hdr, pixel);
    imageStore(hdr, pixel, vec4(cloud.rgb + background.rgb * cloud.a, background.a));
    // Cloud coverage over the scene, for the upscaler (like blended surfaces).
    float mask = imageLoad(transparencyMask, pixel).r;
    imageStore(transparencyMask, pixel, vec4(max(mask, 1.0 - cloud.a)));

    if (1.0 - cloud.a > kMotionOpacity && depthWeight > 0.0) {
        vec3 direction = cloudRay(uv);
        vec4 currentClip = pc.scene.currentViewProjection * vec4(direction, 0.0);
        vec4 previousClip = cloudPreviousClip(direction, depthSum / depthWeight);
        imageStore(motion, pixel,
                   vec4((previousClip.xy / previousClip.w - currentClip.xy / currentClip.w) * 0.5,
                        0.0, 0.0));
    }
}
