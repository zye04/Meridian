#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "atmosphere.glsl"

// Transmittance from any height toward any zenith angle to the top of the
// atmosphere. Depends only on the atmosphere, so it's rebuilt only when that
// changes.

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 4, rgba32f) uniform writeonly image2D transmittanceOut;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(kTransmittanceLutSize)))) {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / kTransmittanceLutSize;
    float viewHeight;
    float viewZenithCos;
    transmittanceLutParameters(uv, viewHeight, viewZenithCos);

    vec3 position = vec3(0.0, viewHeight, 0.0);
    vec3 direction = vec3(sqrt(1.0 - viewZenithCos * viewZenithCos), viewZenithCos, 0.0);
    ScatteringResult result = integrateScatteredLuminance(
        position, direction, direction, 40.0, false, false, false, false, 9e6);
    imageStore(transmittanceOut, pixel, vec4(exp(-result.opticalDepth), 1.0));
}
