#version 460
#extension GL_GOOGLE_include_directive : require
#define MERIDIAN_CUSTOM_PUSH_CONSTANTS
#include "common.glsl"
#include "cull.glsl"
#include "farfield.glsl"

// Cell culling, one thread per 64 m placement cell, in both phases of the
// instance cull (cull.comp): phase 0 takes the cells visible last frame
// (frustum only), phase 1 tests every cell against the frustum and this
// frame's depth pyramid and records cell visibility. A cell's box is its
// square grown by the instances' horizontal reach (cellMargin) and their
// height range. Survivors emit their instances as chunks of up to 64 ids;
// the streamed (slot, layer) records follow the grid's cells, their box from
// their cell coordinates and their heights widened by the terrain detail
// the instances are lifted by; threads past them emit the hand-placed
// instances the same way.
// Grid cells past the far switch skip their trees (the start of their run) and
// go through the same two phases for voxel.mesh: phase 0 lists the far
// cells drawn last frame that are in the frustum (early pass), phase 1
// tests every far cell against the new pyramid and lists those newly
// visible (late pass). A cell's visibility word: bit 0 its instances were
// visible, bit 1 far, bit 2 its voxels were visible, bits 3-4 its level.

layout(local_size_x = 64) in;

const uint kCellVisible = 1u;
const uint kCellFar = 2u;
const uint kCellFarVisible = 4u;
const uint kCellLevelShift = 3u;

void emitChunks(uint firstId, uint count, bool cellWasVisible) {
    uint chunkCount = (count + 63u) / 64u;
    uint first = reserveEntries(kCounterChunkDispatch + cull.phase * 3u, kMaxChunks, 0u,
                                chunkCount);
    for (uint i = 0u; i < chunkCount; ++i) {
        uint size = min(64u, count - i * 64u);
        cull.chunks.chunks[first + i] =
            uvec2(firstId + i * 64u, size | (cellWasVisible ? kChunkCellWasVisible : 0u));
    }
}

// Whether the cell draws its voxels (farSwitch, with last frame's state from
// its visibility word): the L0 voxel's projection from the nearest point of
// its canopy box. A cell with bricks but no trees (crowns reaching in from
// a neighbor) is far too. Out: the level, and the box the voxels can reach
// (relative to the camera) for the frustum and occlusion tests.
bool farCell(SceneBuffer scene, uint index, uvec2 gridIndex, uint word, out uint level,
             out vec3 reachLo, out vec3 reachHi) {
    level = 0u;
    reachLo = reachHi = vec3(0.0);
    FarCell far = scene.farField.field.cells.cells[index];
    if (far.top < far.bottom) {
        return false;
    }
    vec2 lo = vec2(ivec2(gridIndex) + scene.cellGrid) * kCellSize;
    vec3 boxLo = vec3(lo.x, far.bottom, lo.y) - scene.cameraPosition;
    vec3 boxHi = vec3(lo.x + kCellSize, far.top, lo.y + kCellSize) - scene.cameraPosition;
    float distance = max(length(max(max(boxLo, -boxHi), vec3(0.0))), scene.nearPlane);
    float pixelsPerMeter = abs(scene.projectionScale.y) * 0.5 / scene.inverseResolution.y / distance;
    float voxelPixels = farVoxelSize(0u) * pixelsPerMeter;
    bool wasFar = (word & kCellFar) != 0u;
    if (!farSwitch(voxelPixels, wasFar, kFarSwitchPixels, kFarSwitchHysteresis)) {
        return false;
    }
    level = farLevel(voxelPixels, wasFar ? (word >> kCellLevelShift) & 3u : kFarLevels,
                     kFarSwitchHysteresis);
    // The voxels reach up to the level's pad past the canopy extent.
    vec3 pad = vec3(0.0, farCanopyPad(level), 0.0);
    reachLo = boxLo - pad;
    reachHi = boxHi + pad;
    return true;
}

void main() {
    SceneBuffer scene = cull.scene;
    uint index = gl_GlobalInvocationID.x;
    uint gridCells = scene.cellGridSize.x * scene.cellGridSize.y;
    uint cellCount = gridCells + scene.streamRecordCount;
    if (index >= cellCount) {
        uint first = (index - cellCount) * 64u;
        // Phase 0 is skipped without occlusion culling (see cull.comp).
        if (first < scene.instanceCount && (cull.phase == 1u || cull.occlusion != 0u)) {
            emitChunks(first, min(64u, scene.instanceCount - first), true);
        }
        return;
    }
    Cell cell = scene.cells.cells[index];
    uvec2 gridIndex = uvec2(index % scene.cellGridSize.x, index / scene.cellGridSize.x);
    // Cell bits follow the instance ids' (static and ring) in the visibility
    // buffer.
    uint visibilityIndex = kPlacedBase + scene.placedCount + scene.ringCount + index;
    uint word = cull.visibility.visible[visibilityIndex];

    uint level;
    vec3 reachLo, reachHi;
    bool isFar = scene.farFieldEnabled != 0u && index < gridCells &&
                 farCell(scene, index, gridIndex, word, level, reachLo, reachHi);
    uint farBits = 0u;
    uint skipped = 0u;
    if (isFar) {
        skipped = scene.farField.field.cells.cells[index].treeCount;
        farBits = kCellFar | level << kCellLevelShift;
        uint entry = index | level << 30u;
        bool inFrustum = displayedBoxInFrustum(scene, reachLo, reachHi);
        // What phase 0 drew, so phase 1 lists only the rest.
        bool drawnEarly = cull.occlusion != 0u && (word & kCellFarVisible) != 0u && inFrustum;
        if (cull.phase == 0u) {
            if (drawnEarly) {
                uint slot = atomicAdd(cull.counters.counters[kCounterFarTasks], 1u);
                scene.farCellList.entries[slot] = entry;
            }
        } else {
            bool farVisible = inFrustum;
            if (farVisible && cull.occlusion != 0u) {
                vec3 center = (reachLo + reachHi) * 0.5;
                farVisible = !occluded(displayedSphere(center, length(reachHi - reachLo) * 0.5),
                                       scene.view);
            }
            if (farVisible) {
                farBits |= kCellFarVisible;
                if (!drawnEarly) {
                    uint slot = atomicAdd(cull.counters.counters[kCounterFarTasks + 3u], 1u);
                    scene.farCellList.entries[gridCells + slot] = entry;
                }
            }
        }
    }
    if (cell.instanceCount <= skipped) {
        // Drawn as voxels only: none of its instances were visible.
        if (cull.phase == 1u) {
            cull.visibility.visible[visibilityIndex] = farBits;
        }
        return;
    }
    ivec2 coordinates;
    float lift = 0.0;
    if (index < gridCells) {
        coordinates = ivec2(uvec2(index % scene.cellGridSize.x, index / scene.cellGridSize.x)) +
                      scene.cellGrid;
    } else {
        coordinates = scene.streamCoords.coords[index - gridCells];
        lift = kTerrainDetailAmplitude;
    }
    vec2 lo = vec2(coordinates) * kCellSize - scene.cellMargin;
    vec2 hi = lo + kCellSize + 2.0 * scene.cellMargin;
    vec3 boxLo = vec3(lo.x, cell.minY - lift, lo.y) - scene.cameraPosition;
    vec3 boxHi = vec3(hi.x, cell.maxY + lift, hi.y) - scene.cameraPosition;
    bool visible = displayedBoxInFrustum(scene, boxLo, boxHi) &&
                   (scene.cellDrawDistance == 0.0 ||
                    length(max(max(boxLo, -boxHi), vec3(0.0))) <= scene.cellDrawDistance);

    bool wasVisible = (word & kCellVisible) != 0u;
    if (cull.phase == 0u) {
        if (cull.occlusion != 0u && wasVisible && visible) {
            emitChunks(kPlacedBase + cell.firstInstance + skipped, cell.instanceCount - skipped,
                       true);
        }
        return;
    }
    if (visible && cull.occlusion != 0u) {
        vec3 center = (boxLo + boxHi) * 0.5;
        visible = !occluded(displayedSphere(center, length(boxHi - boxLo) * 0.5), scene.view);
    }
    cull.visibility.visible[visibilityIndex] = farBits | (visible ? kCellVisible : 0u);
    if (!visible) {
        return;
    }
    atomicAdd(cull.counters.counters[kCounterCells], 1u);
    emitChunks(kPlacedBase + cell.firstInstance + skipped, cell.instanceCount - skipped,
               cull.occlusion != 0u && wasVisible);
}
